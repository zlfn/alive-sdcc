// SDCC peephole rules for the Z80, made by convert.py.

// peeph.def:20: common peephole 0a removed redundant load from %1 into %1.
// if notVolatile(%1)
rule peeph-20
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        ld	v1, v1
    after:
    dead: below SP

// peeph.def:37: common peephole 1 removed dead load from %2 into %1.
// if notVolatile(%1), notUsed(%1), notVolatile(%2), notSame(%1 '(hl+)' '(hl-)'), notSame(%2 '(hl+)' '(hl-)')
rule peeph-37
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k1, k2 in u16; o1, o2 in s8
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v2 != '(hl+)' && v2 != '(hl-)'  // notSame(%2 '(hl+)' '(hl-)')
    if: v1 != v2  // not ld x, x
    before:
        ld	v1, v2
    after:
    dead: v1

// peeph.def:43: common peephole 2a removed %1 hl, %2 due to unused result.
// if same(%1 'adc' 'sbc'), notUsed('hl' 'f')
rule peeph-43
    for: v1 in adc | sbc
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k2 in u16; o2 in s8
    if: v1 == 'adc' || v1 == 'sbc'  // same(%1 'adc' 'sbc')
    before:
        v1	hl, v2
    after:
    dead: CF, HF, HL, NF, PVF, SF, ZF, below SP

// peeph.def:49: common peephole 2b removed add hl, %2 due to unused result.
// if notUsed('hl' 'cf' 'nf')
rule peeph-49
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k2 in u16; o2 in s8
    before:
        add	hl, v2
    after:
    dead: CF, HL, NF, below SP

// peeph.def:55: common peephole 2c removed %1 %2 due to unused result.
// if same(%1 'dec' 'inc'), same(%2 'bc' 'de' 'hl' 'sp' 'ix' 'iy'), notUsed(%2)
rule peeph-55
    for: v1 in dec | inc
    for: v2 in bc | de | hl | sp | ix | iy
    if: v1 == 'dec' || v1 == 'inc'  // same(%1 'dec' 'inc')
    if: v2 == bc || v2 == de || v2 == hl || v2 == sp || v2 == ix || v2 == iy  // same(%2 'bc' 'de' 'hl' 'sp' 'ix' 'iy')
    before:
        v1	v2
    after:
    dead: v2

// peeph.def:61: common peephole 2d removed %1 due to unused result.
// if same(%1 'rlca' 'rla' 'rrca' 'rra'), notUsed('a' 'hf' 'nf' 'cf')
rule peeph-61
    for: v1 in rlca | rla | rrca | rra
    if: v1 == 'rlca' || v1 == 'rla' || v1 == 'rrca' || v1 == 'rra'  // same(%1 'rlca' 'rla' 'rrca' 'rra')
    before:
        v1
    after:
    dead: A, CF, HF, NF, below SP

// peeph.def:67: common peephole 3 removed dead load from %2 + %3 into %1.
// if notVolatile(%1), notUsed(%1), notSame(%1 '(hl+)' '(hl-)')
rule peeph-67
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: k1, k2, k3 in u16; o1, o2, o3 in s8
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    before:
        ld	v1, v2 + v3
    after:
    dead: v1

// peeph.def:74: common peephole 3a replaced adc by add since l is unused.
// if notUsed('l' 'zf')
rule peeph-74
    before:
        adc	hl, hl
        adc	hl, hl
    after:
        add	hl, hl
        add	hl, hl
    dead: L, ZF, below SP

// peeph.def:83: common peephole 3b replaced adc by add since l is unused.
// if notUsed('l' 'zf')
rule peeph-83
    before:
        adc	hl, hl
    after:
        add	hl, hl
    dead: L, ZF, below SP

// peeph.def:91: common peephole 5 removed dead %1 %2.
// if same(%1 'inc' 'dec'), same(%2 'bc' 'de' 'hl' 'sp' 'ix' 'iy'), notUsed(%2)
rule peeph-91
    for: v1 in inc | dec
    for: v2 in bc | de | hl | sp | ix | iy
    if: v1 == 'inc' || v1 == 'dec'  // same(%1 'inc' 'dec')
    if: v2 == bc || v2 == de || v2 == hl || v2 == sp || v2 == ix || v2 == iy  // same(%2 'bc' 'de' 'hl' 'sp' 'ix' 'iy')
    before:
        v1	v2
    after:
    dead: v2

// peeph.def:98: common peephole 6a removed dead %1 %2
// if same(%1 'inc' 'dec'), same(%2 'a' 'b' 'c' 'd' 'e' 'h' 'l' 'ixh' 'ixl' 'iyh' 'iyl'), notUsed(%2 'f')
rule peeph-98
    for: v1 in inc | dec
    for: v2 in a | b | c | d | e | h | l
    if: v1 == 'inc' || v1 == 'dec'  // same(%1 'inc' 'dec')
    if: v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == ixh || v2 == ixl || v2 == iyh || v2 == iyl  // same(%2 'a' 'b' 'c' 'd' 'e' 'h' 'l' 'ixh' 'ixl' 'iyh' 'iyl')
    before:
        v1	v2
    after:
    dead: CF, HF, NF, PVF, SF, ZF, v2, below SP

// peeph.def:105: common peephole 6b removed dead %1 a, %2
// if same(%1 'sub' 'sbc' 'add' 'adc' 'and' 'or' 'xor'), notUsed('af')
rule peeph-105
    for: v1 in sub | sbc | add | adc | and | or | xor
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k2 in u16; o2 in s8
    if: v1 == 'sub' || v1 == 'sbc' || v1 == 'add' || v1 == 'adc' || v1 == 'and' || v1 == 'or' || v1 == 'xor'  // same(%1 'sub' 'sbc' 'add' 'adc' 'and' 'or' 'xor')
    before:
        v1	a, v2
    after:
    dead: A, CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:112: common peephole 6c removed dead cp a, %1
// if notUsed('f')
rule peeph-112
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        cp	a, v1
    after:
    dead: CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:118: common peephole 6d removed dead %1 %2
// if same(%1 'rlc' 'rl' 'rrc' 'rr' 'sla' 'sra' 'srl' 'sll' 'sli' 'bool'), notVolatile(%2), notUsed(%2 'f')
rule peeph-118
    for: v1 in rlc | rl | rrc | rr | sla | sra | srl | sll | sli | bool
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k2 in u16; o2 in s8
    if: v1 == 'rlc' || v1 == 'rl' || v1 == 'rrc' || v1 == 'rr' || v1 == 'sla' || v1 == 'sra' || v1 == 'srl' || v1 == 'sll' || v1 == 'sli' || v1 == 'bool'  // same(%1 'rlc' 'rl' 'rrc' 'rr' 'sla' 'sra' 'srl' 'sll' 'sli' 'bool')
    before:
        v1	v2
    after:
    dead: CF, HF, NF, PVF, SF, ZF, v2

// peeph.def:124: common peephole 7 removed dead load from %2 (%3) into %1.
// if notUsed(%1), same(%3 'ix' 'iy' 'hl')
rule peeph-124
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in ix | iy
    for: k1 in u16; k2, o1 in s8
    if: v3 == ix || v3 == iy || v3 == hl  // same(%3 'ix' 'iy' 'hl')
    before:
        ld	v1, k2 (v3)
    after:
    dead: v1

// peeph.def:131: common peephole 8 removed double de/hl swap.
rule peeph-131
    before:
        ex	de, hl
        ex	de, hl
    after:
    dead: below SP

// peeph.def:138: common peephole 9 loaded %3 from %2 directly instead of going through %1.
// if canAssign(%3 %2), notVolatile(%1), notUsed(%1), notSame(%3 '(hl)' '(de)' '(bc)' '(hl+)' '(hl-)'), notSame(%1 '(hl+)' '(hl-)')
rule peeph-138
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | #k2 | (k2)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | (k3)
    for: k1, k2, k3 in u16; o1 in s8
    if: (v3 == a && (v2 != bc && v2 != de && v2 != hl && v2 != sp && v2 != ix && v2 != iy)) || ((v3 == b || v3 == c || v3 == d || v3 == e || v3 == h || v3 == l) && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '(hl)' || v2 == '#k2')) || ((v3 == bc || v3 == de) && (v2 == '#k2' || v2 == '(k2)')) || ((v3 == hl || v3 == ix || v3 == iy) && (v2 == sp || v2 == '#k2' || v2 == '(k2)')) || (v3 == sp && (v2 == hl || v2 == ix || v2 == iy)) || (v3 == '(hl)' && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '#k2')) || ((v3 == '(de)' || v3 == '(bc)') && v2 == a) || (v3 == '(k3)' && (v2 == a || v2 == bc || v2 == de || v2 == hl || v2 == sp || v2 == ix || v2 == iy))  // canAssign(%3 %2)
    if: v3 != '(hl)' && v3 != '(de)' && v3 != '(bc)' && v3 != '(hl+)' && v3 != '(hl-)'  // notSame(%3 '(hl)' '(de)' '(bc)' '(hl+)' '(hl-)')
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v1 != v2  // not ld x, x
    if: v3 != v1  // not ld x, x
    before:
        ld	v1, v2
        ld	v3, v1
    after:
        ld	v3, v2
    dead: v1

// peeph.def:146: common peephole 9a loaded %3 from %2 directly instead of going through %1.
// if canAssign(%3 %2), notVolatile(%1), notUsed(%1), canAssign('a' %1), notSame(%1 '(hl+)' '(hl-)'), operandsNotRelated(%1 %3)
rule peeph-146
    for: v1 in a | b | c | d | e | h | l | (hl) | (de) | (bc) | #k1 | (k1)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | #k2 | (k2)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | (k3)
    for: k1, k2, k3 in u16
    if: (v3 == a && (v2 != bc && v2 != de && v2 != hl && v2 != sp && v2 != ix && v2 != iy)) || ((v3 == b || v3 == c || v3 == d || v3 == e || v3 == h || v3 == l) && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '(hl)' || v2 == '#k2')) || ((v3 == bc || v3 == de) && (v2 == '#k2' || v2 == '(k2)')) || ((v3 == hl || v3 == ix || v3 == iy) && (v2 == sp || v2 == '#k2' || v2 == '(k2)')) || (v3 == sp && (v2 == hl || v2 == ix || v2 == iy)) || (v3 == '(hl)' && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '#k2')) || ((v3 == '(de)' || v3 == '(bc)') && v2 == a) || (v3 == '(k3)' && (v2 == a || v2 == bc || v2 == de || v2 == hl || v2 == sp || v2 == ix || v2 == iy))  // canAssign(%3 %2)
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: (v1 == a && v3 != a) || ((v1 == b || v1 == c) && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)')) || ((v1 == d || v1 == e) && (v3 != d && v3 != e && v3 != de && v3 != '(de)')) || ((v1 == h || v1 == l) && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)')) || (v1 == '(hl)' && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)' && v3 != '(k3)')) || (v1 == '(de)' && (v3 != d && v3 != e && v3 != de && v3 != '(de)' && v3 != '(k3)')) || (v1 == '(bc)' && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)' && v3 != '(k3)')) || v1 == '#k1' || (v1 == '(k1)' && v3 != '(k3)')  // operandsNotRelated(%1 %3)
    if: v1 != v2  // not ld x, x
    if: v3 != v1  // not ld x, x
    before:
        ld	v1, v2
        ld	v3, v1
    after:
        ld	v3, v2
    dead: v1, below SP

// peeph.def:154: common peephole 9b reused value still in hl.
// if notVolatile(%1), notSame(%1 '(hl+)' '(hl-)')
rule peeph-154
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v1 != hl  // not ld x, x
    if: hl != v1  // not ld x, x
    before:
        ld	v1, hl
        ld	hl, v1
    after:
        ld	v1, hl
    dead: below SP

// peeph.def:162: common peephole 9c reused value still in hl.
// if notUsed('hf'), notUsed('cf')
rule peeph-162
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: v1 != hl  // not ld x, x
    before:
        ld	v1, hl
        ld	hl, #0
        add	hl, v1
    after:
        ld	v1, hl
    dead: CF, HF, below SP

// peeph.def:171: common peephole 10 loaded %5 from %2 directly instead of going through %1.
// if canAssign(%5 %2), notVolatile(%1), operandsNotRelated(%1 %4), operandsNotRelated(%1 %3), operandsNotRelated(%3 %5), operandsNotRelated(%4 %5), notUsed(%1), notSame(%3 %4 '(hl)' '(de)' '(bc)' '(hl+)' '(hl-)'), notVolatile(%5), notSame(%1 '(hl+)' '(hl-)'), notSame(%5 '(hl+)' '(hl-)')
rule peeph-171
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | #k2 | (k2)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: v5 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | (k5)
    for: k1, k2, k3, k4, k5 in u16; o1, o3, o4 in s8
    if: (v5 == a && (v2 != bc && v2 != de && v2 != hl && v2 != sp && v2 != ix && v2 != iy)) || ((v5 == b || v5 == c || v5 == d || v5 == e || v5 == h || v5 == l) && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '(hl)' || v2 == '#k2')) || ((v5 == bc || v5 == de) && (v2 == '#k2' || v2 == '(k2)')) || ((v5 == hl || v5 == ix || v5 == iy) && (v2 == sp || v2 == '#k2' || v2 == '(k2)')) || (v5 == sp && (v2 == hl || v2 == ix || v2 == iy)) || (v5 == '(hl)' && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '#k2')) || ((v5 == '(de)' || v5 == '(bc)') && v2 == a) || (v5 == '(k5)' && (v2 == a || v2 == bc || v2 == de || v2 == hl || v2 == sp || v2 == ix || v2 == iy))  // canAssign(%5 %2)
    if: ((v1 == a || v1 == af) && (v4 != a && v4 != af)) || ((v1 == b || v1 == c || v1 == bc) && (v4 != b && v4 != c && v4 != bc && v4 != '(bc)')) || ((v1 == d || v1 == e || v1 == de) && (v4 != d && v4 != e && v4 != de && v4 != '(de)')) || ((v1 == h || v1 == l || v1 == hl) && (v4 != h && v4 != l && v4 != hl && v4 != '(hl)')) || (v1 == sp && v4 != sp) || (v1 == '(hl)' && (v4 != h && v4 != l && v4 != hl && v4 != '(hl)' && v4 != '(k4)')) || (v1 == '(de)' && (v4 != d && v4 != e && v4 != de && v4 != '(de)' && v4 != '(k4)')) || (v1 == '(bc)' && (v4 != b && v4 != c && v4 != bc && v4 != '(bc)' && v4 != '(k4)')) || (v1 == ix && (v4 != ix && v4 != 'o4 (ix)')) || (v1 == iy && (v4 != iy && v4 != 'o4 (iy)')) || (v1 == '#k1' && (v4 != '#k4' || (v4 == '#k4' && !(k4 == k1)))) || (v1 == '(k1)' && v4 != '(k4)') || (v1 == 'o1 (ix)' && (v4 != ix && v4 != '(k4)' && v4 != 'o4 (ix)')) || (v1 == 'o1 (iy)' && (v4 != iy && v4 != '(k4)' && v4 != 'o4 (iy)'))  // operandsNotRelated(%1 %4)
    if: ((v1 == a || v1 == af) && (v3 != a && v3 != af)) || ((v1 == b || v1 == c || v1 == bc) && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)')) || ((v1 == d || v1 == e || v1 == de) && (v3 != d && v3 != e && v3 != de && v3 != '(de)')) || ((v1 == h || v1 == l || v1 == hl) && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)')) || (v1 == sp && v3 != sp) || (v1 == '(hl)' && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)' && v3 != '(k3)')) || (v1 == '(de)' && (v3 != d && v3 != e && v3 != de && v3 != '(de)' && v3 != '(k3)')) || (v1 == '(bc)' && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)' && v3 != '(k3)')) || (v1 == ix && (v3 != ix && v3 != 'o3 (ix)')) || (v1 == iy && (v3 != iy && v3 != 'o3 (iy)')) || (v1 == '#k1' && (v3 != '#k3' || (v3 == '#k3' && !(k3 == k1)))) || (v1 == '(k1)' && v3 != '(k3)') || (v1 == 'o1 (ix)' && (v3 != ix && v3 != '(k3)' && v3 != 'o3 (ix)')) || (v1 == 'o1 (iy)' && (v3 != iy && v3 != '(k3)' && v3 != 'o3 (iy)'))  // operandsNotRelated(%1 %3)
    if: ((v3 == a || v3 == af) && v5 != a) || ((v3 == b || v3 == c || v3 == bc) && (v5 != b && v5 != c && v5 != bc && v5 != '(bc)')) || ((v3 == d || v3 == e || v3 == de) && (v5 != d && v5 != e && v5 != de && v5 != '(de)')) || ((v3 == h || v3 == l || v3 == hl) && (v5 != h && v5 != l && v5 != hl && v5 != '(hl)')) || (v3 == sp && v5 != sp) || (v3 == '(hl)' && (v5 != h && v5 != l && v5 != hl && v5 != '(hl)' && v5 != '(k5)')) || (v3 == '(de)' && (v5 != d && v5 != e && v5 != de && v5 != '(de)' && v5 != '(k5)')) || (v3 == '(bc)' && (v5 != b && v5 != c && v5 != bc && v5 != '(bc)' && v5 != '(k5)')) || (v3 == ix && v5 != ix) || (v3 == iy && v5 != iy) || v3 == '#k3' || (v3 == '(k3)' && v5 != '(k5)') || (v3 == 'o3 (ix)' && (v5 != ix && v5 != '(k5)')) || (v3 == 'o3 (iy)' && (v5 != iy && v5 != '(k5)'))  // operandsNotRelated(%3 %5)
    if: ((v4 == a || v4 == af) && v5 != a) || ((v4 == b || v4 == c || v4 == bc) && (v5 != b && v5 != c && v5 != bc && v5 != '(bc)')) || ((v4 == d || v4 == e || v4 == de) && (v5 != d && v5 != e && v5 != de && v5 != '(de)')) || ((v4 == h || v4 == l || v4 == hl) && (v5 != h && v5 != l && v5 != hl && v5 != '(hl)')) || (v4 == sp && v5 != sp) || (v4 == '(hl)' && (v5 != h && v5 != l && v5 != hl && v5 != '(hl)' && v5 != '(k5)')) || (v4 == '(de)' && (v5 != d && v5 != e && v5 != de && v5 != '(de)' && v5 != '(k5)')) || (v4 == '(bc)' && (v5 != b && v5 != c && v5 != bc && v5 != '(bc)' && v5 != '(k5)')) || (v4 == ix && v5 != ix) || (v4 == iy && v5 != iy) || v4 == '#k4' || (v4 == '(k4)' && v5 != '(k5)') || (v4 == 'o4 (ix)' && (v5 != ix && v5 != '(k5)')) || (v4 == 'o4 (iy)' && (v5 != iy && v5 != '(k5)'))  // operandsNotRelated(%4 %5)
    if: v3 != v4 && v3 != '(hl)' && v3 != '(de)' && v3 != '(bc)' && v3 != '(hl+)' && v3 != '(hl-)' && v4 != '(hl)' && v4 != '(de)' && v4 != '(bc)' && v4 != '(hl+)' && v4 != '(hl-)'  // notSame(%3 %4 '(hl)' '(de)' '(bc)' '(hl+)' '(hl-)')
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v5 != '(hl+)' && v5 != '(hl-)'  // notSame(%5 '(hl+)' '(hl-)')
    if: v1 != v2  // not ld x, x
    if: v3 != v4  // not ld x, x
    if: v5 != v1  // not ld x, x
    before:
        ld	v1, v2
        ld	v3, v4
        ld	v5, v1
    after:
        ld	v5, v2
        ld	v3, v4
    dead: v1

// peeph.def:183: common peephole 11 loaded %5%6 from %1%2 directly instead of going through %3 (ix) %4 (ix).
// if canAssign(%5 %1), canAssign(%6 %2), notSame(%5 %2)
rule peeph-183
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | #k1 | (k1)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | #k2 | (k2)
    for: v5 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | (k5)
    for: v6 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | (k6)
    for: k1, k2, k5, k6 in u16; k3, k4 in s8
    if: (v5 == a && (v1 != bc && v1 != de && v1 != hl && v1 != sp && v1 != ix && v1 != iy)) || ((v5 == b || v5 == c || v5 == d || v5 == e || v5 == h || v5 == l) && (v1 == a || v1 == b || v1 == c || v1 == d || v1 == e || v1 == h || v1 == l || v1 == '(hl)' || v1 == '#k1')) || ((v5 == bc || v5 == de) && (v1 == '#k1' || v1 == '(k1)')) || ((v5 == hl || v5 == ix || v5 == iy) && (v1 == sp || v1 == '#k1' || v1 == '(k1)')) || (v5 == sp && (v1 == hl || v1 == ix || v1 == iy)) || (v5 == '(hl)' && (v1 == a || v1 == b || v1 == c || v1 == d || v1 == e || v1 == h || v1 == l || v1 == '#k1')) || ((v5 == '(de)' || v5 == '(bc)') && v1 == a) || (v5 == '(k5)' && (v1 == a || v1 == bc || v1 == de || v1 == hl || v1 == sp || v1 == ix || v1 == iy))  // canAssign(%5 %1)
    if: (v6 == a && (v2 != bc && v2 != de && v2 != hl && v2 != sp && v2 != ix && v2 != iy)) || ((v6 == b || v6 == c || v6 == d || v6 == e || v6 == h || v6 == l) && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '(hl)' || v2 == '#k2')) || ((v6 == bc || v6 == de) && (v2 == '#k2' || v2 == '(k2)')) || ((v6 == hl || v6 == ix || v6 == iy) && (v2 == sp || v2 == '#k2' || v2 == '(k2)')) || (v6 == sp && (v2 == hl || v2 == ix || v2 == iy)) || (v6 == '(hl)' && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '#k2')) || ((v6 == '(de)' || v6 == '(bc)') && v2 == a) || (v6 == '(k6)' && (v2 == a || v2 == bc || v2 == de || v2 == hl || v2 == sp || v2 == ix || v2 == iy))  // canAssign(%6 %2)
    if: v5 != v2  // notSame(%5 %2)
    before:
        ld	k3 (ix), v1
        ld	k4 (ix), v2
        ld	v5, k3 (ix)
        ld	v6, k4 (ix)
    after:
        ld	k3 (ix), v1
        ld	k4 (ix), v2
        ld	v5, v1
        ld	v6, v2
    dead: below SP

// peeph.def:196: common peephole 12 loaded %2 (%3) into %4 directly instead of going through %1.
// if canAssign(%4 %2 %3), notVolatile(%1), notUsed(%1)
rule peeph-196
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in ix | iy
    for: v4 in a | b | c | d | e | h | l
    for: k1 in u16; k2, o1 in s8
    if: v4 != v1  // not ld x, x
    before:
        ld	v1, k2 (v3)
        ld	v4, v1
    after:
        ld	v4, k2 (v3)
    dead: v1

// peeph.def:204: common peephole 13 loaded %2 into %3 (%4) directly instead of going through %1.
// if canAssign(%3 %4 %2), notVolatile(%1), notUsed(%1), canAssign('a' %1)
rule peeph-204
    for: v1 in a | b | c | d | e | h | l | (hl) | (de) | (bc) | #k1 | (k1)
    for: v2 in a | b | c | d | e | h | l | #k2
    for: v4 in ix | iy
    for: k1, k2 in u16; k3 in s8
    if: v1 != v2  // not ld x, x
    before:
        ld	v1, v2
        ld	k3 (v4), v1
    after:
        ld	k3 (v4), v2
    dead: v1, below SP

// peeph.def:213: common peephole 14 loaded %2 (%3) into %7 directly instead of going through %1.
// if canAssign(%7 %2 %3), notVolatile(%1), notUsed(%1), notSame(%1 %4), notSame(%7 %4)
rule peeph-213
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in ix | iy
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: v6 in ix | iy
    for: v7 in a | b | c | d | e | h | l
    for: k1, k4 in u16; k2, k5, o1, o4 in s8
    if: v1 != v4  // notSame(%1 %4)
    if: v7 != v4  // notSame(%7 %4)
    if: v7 != v1  // not ld x, x
    before:
        ld	v1, k2 (v3)
        ld	v4, k5 (v6)
        ld	v7, v1
    after:
        ld	v7, k2 (v3)
        ld	v4, k5 (v6)
    dead: v1

// peeph.def:223: common peephole 15 loaded %2 (%3) into %7 directly instead of going through %1.
// if canAssign(%7 %2 %3), notVolatile(%1), notUsed(%1), operandsNotRelated(%1 %5), operandsNotRelated(%7 %4), operandsNotRelated(%7 %5), notSame(%4 '(hl)' '(de)' '(bc)' '(hl+)' '(hl-)'), notSame(%5 '(hl)' '(de)' '(bc)' '(hl+)' '(hl-)' '(iy)')
rule peeph-223
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in ix | iy
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: v5 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k5 | (k5) | o5 (ix) | o5 (iy)
    for: v7 in a | b | c | d | e | h | l
    for: k1, k4, k5 in u16; k2, o1, o4, o5 in s8
    if: ((v1 == a || v1 == af) && (v5 != a && v5 != af)) || ((v1 == b || v1 == c || v1 == bc) && (v5 != b && v5 != c && v5 != bc && v5 != '(bc)')) || ((v1 == d || v1 == e || v1 == de) && (v5 != d && v5 != e && v5 != de && v5 != '(de)')) || ((v1 == h || v1 == l || v1 == hl) && (v5 != h && v5 != l && v5 != hl && v5 != '(hl)')) || (v1 == sp && v5 != sp) || (v1 == '(hl)' && (v5 != h && v5 != l && v5 != hl && v5 != '(hl)' && v5 != '(k5)')) || (v1 == '(de)' && (v5 != d && v5 != e && v5 != de && v5 != '(de)' && v5 != '(k5)')) || (v1 == '(bc)' && (v5 != b && v5 != c && v5 != bc && v5 != '(bc)' && v5 != '(k5)')) || (v1 == ix && (v5 != ix && v5 != 'o5 (ix)')) || (v1 == iy && (v5 != iy && v5 != 'o5 (iy)')) || (v1 == '#k1' && (v5 != '#k5' || (v5 == '#k5' && !(k5 == k1)))) || (v1 == '(k1)' && v5 != '(k5)') || (v1 == 'o1 (ix)' && (v5 != ix && v5 != '(k5)' && v5 != 'o5 (ix)')) || (v1 == 'o1 (iy)' && (v5 != iy && v5 != '(k5)' && v5 != 'o5 (iy)'))  // operandsNotRelated(%1 %5)
    if: (v7 == a && (v4 != a && v4 != af)) || ((v7 == b || v7 == c) && (v4 != b && v4 != c && v4 != bc && v4 != '(bc)')) || ((v7 == d || v7 == e) && (v4 != d && v4 != e && v4 != de && v4 != '(de)')) || ((v7 == h || v7 == l) && (v4 != h && v4 != l && v4 != hl && v4 != '(hl)'))  // operandsNotRelated(%7 %4)
    if: (v7 == a && (v5 != a && v5 != af)) || ((v7 == b || v7 == c) && (v5 != b && v5 != c && v5 != bc && v5 != '(bc)')) || ((v7 == d || v7 == e) && (v5 != d && v5 != e && v5 != de && v5 != '(de)')) || ((v7 == h || v7 == l) && (v5 != h && v5 != l && v5 != hl && v5 != '(hl)'))  // operandsNotRelated(%7 %5)
    if: v4 != '(hl)' && v4 != '(de)' && v4 != '(bc)' && v4 != '(hl+)' && v4 != '(hl-)'  // notSame(%4 '(hl)' '(de)' '(bc)' '(hl+)' '(hl-)')
    if: v5 != '(hl)' && v5 != '(de)' && v5 != '(bc)' && v5 != '(hl+)' && v5 != '(hl-)' && v5 != '(iy)'  // notSame(%5 '(hl)' '(de)' '(bc)' '(hl+)' '(hl-)' '(iy)')
    if: v4 != v5  // not ld x, x
    if: v7 != v1  // not ld x, x
    before:
        ld	v1, k2 (v3)
        ld	v4, v5
        ld	v7, v1
    after:
        ld	v7, k2 (v3)
        ld	v4, v5
    dead: v1

// peeph.def:233: common peephole 16 loaded %2 into a directly instead of going through %1.
// if notUsed(%1)
rule peeph-233
    for: v1 in ix | iy
    for: k2 in u16; k3 in -128..65535; x0 in -32768..65535
    if: x0 == k2 + k3
    before:
        ld	v1, #k2
        ld	a, k3 (v1)
    after:
        ld	a, (x0)
    dead: v1, below SP

// peeph.def:241: common peephole 17 loaded a from (#%1) directly instead of using hl.
// if notUsed('hl')
rule peeph-241
    for: k1 in u16
    before:
        ld	hl, #k1
        ld	a, (hl)
    after:
        ld	a, (k1)
    dead: HL, below SP

// peeph.def:249: common peephole 18 loaded %2 into a directly instead of using hl.
// if notUsed('hl')
rule peeph-249
    for: k1, k2 in u16; x0 in -32768..65535
    if: x0 == k1 + k2
    before:
        ld	hl, #x0
        ld	a, (hl)
    after:
        ld	a, (x0)
    dead: HL, below SP

// peeph.def:257: common peephole 19 loaded (#%1) from a directly instead of using hl.
// if notUsed('hl')
rule peeph-257
    for: k1 in u16
    before:
        ld	hl, #k1
        ld	(hl), a
    after:
        ld	(k1), a
    dead: HL, below SP

// peeph.def:265: common peephole 20 loaded (#%1) from a directly instead of using hl.
// if notUsed('hl')
rule peeph-265
    for: k1, k2 in u16; x0 in -32768..65535
    if: x0 == k1 + k2
    before:
        ld	hl, #x0
        ld	(hl), a
    after:
        ld	(x0), a
    dead: HL, below SP

// peeph.def:273: common peephole 21 shifted in (%2) instead of a.
// if same(%3 'srl' 'sla' 'rl' 'rr' 'rlc' 'rrc' 'sll')
rule peeph-273
    for: v2 in ix | iy
    for: v3 in srl | sla | rl | rr | rlc | rrc | sll
    for: k1 in s8
    if: v3 == 'srl' || v3 == 'sla' || v3 == 'rl' || v3 == 'rr' || v3 == 'rlc' || v3 == 'rrc' || v3 == 'sll'  // same(%3 'srl' 'sla' 'rl' 'rr' 'rlc' 'rrc' 'sll')
    before:
        ld	a, k1 (v2)
        v3	a
        ld	k1 (v2), a
    after:
        v3	k1 (v2)
        ld	a, k1 (v2)
    dead: below SP

// peeph.def:283: common peephole 22 used (hl) in %4 directly instead of going through %1.
// if notVolatile(%1), notUsed(%1), same(%4 'add' 'adc' 'sub' 'sbc' 'and' 'or' 'xor')
rule peeph-283
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in ix | iy
    for: v4 in add | adc | sub | sbc | and | or | xor
    for: k1 in u16; k2, o1 in s8
    if: v4 == 'add' || v4 == 'adc' || v4 == 'sub' || v4 == 'sbc' || v4 == 'and' || v4 == 'or' || v4 == 'xor'  // same(%4 'add' 'adc' 'sub' 'sbc' 'and' 'or' 'xor')
    before:
        ld	v1, (hl)
        ld	a, k2 (v3)
        v4	a, v1
    after:
        ld	a, k2 (v3)
        v4	a, (hl)
    dead: v1

// peeph.def:293: common peephole 22a used %1 in %3 directly instead of going through %2.
// if notVolatile(%2), notUsed(%2), notSame('a' %2), same(%3 'add' 'adc' 'sub' 'sbc' 'and' 'or' 'xor'), canAssign(%1 'b')
rule peeph-293
    for: v1 in a | b | c | d | e | h | l | (hl)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in add | adc | sub | sbc | and | or | xor
    for: k2 in u16; o2 in s8
    if: a != v2  // notSame('a' %2)
    if: v3 == 'add' || v3 == 'adc' || v3 == 'sub' || v3 == 'sbc' || v3 == 'and' || v3 == 'or' || v3 == 'xor'  // same(%3 'add' 'adc' 'sub' 'sbc' 'and' 'or' 'xor')
    if: v2 != v1  // not ld x, x
    before:
        ld	v2, v1
        v3	a, v2
    after:
        v3	a, v1
    dead: v2

// peeph.def:301: common peephole 23 optimize 16-bit load from %3.
// if canJoinRegs(%2 %1 %3), notUsed(%3 'a')
rule peeph-301
    for: v1 in c | e | l
    for: v2 in b | d | h
    for: v3 in bc | de | hl
    if: (v2 == b && v1 == c && v3 == bc) || (v2 == d && v1 == e && v3 == de) || (v2 == h && v1 == l && v3 == hl)  // canJoinRegs(%2 %1 %3)
    if: l != v1  // not ld x, x
    if: h != v2  // not ld x, x
    before:
        ld	l, v1
        ld	h, v2
        ld	a, (hl)
        inc	hl
        ld	h, (hl)
        ld	l, a
    after:
        ld	a, (v3)
        ld	l, a
        inc	v3
        ld	a, (v3)
        ld	h, a
    dead: A, v3, below SP

// peeph.def:317: common peephole 24 incremented in hl instead of %1.
// if canJoinRegs(%3 %2 %4), same(%1 %4), notUsed(%1)
rule peeph-317
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in c | e | l
    for: v3 in b | d | h
    for: v4 in bc | de | hl
    for: k1 in u16; o1 in s8
    if: (v3 == b && v2 == c && v4 == bc) || (v3 == d && v2 == e && v4 == de) || (v3 == h && v2 == l && v4 == hl)  // canJoinRegs(%3 %2 %4)
    if: v1 == v4  // same(%1 %4)
    if: l != v2  // not ld x, x
    if: h != v3  // not ld x, x
    before:
        inc	v1
        ld	l, v2
        ld	h, v3
    after:
        ld	l, v2
        ld	h, v3
        inc	hl
    dead: v1

// peeph.def:328: common peephole 25a loaded #%1 into (hl) instead of (%4).
// if canJoinRegs(%2 %1 %5), same(%4 %5), notUsed('a')
rule peeph-328
    for: v1 in c | e | l
    for: v2 in b | d | h
    for: v4 in hl | de | bc | sp | c | ix | iy | k4
    for: v5 in bc | de | hl
    for: k3, k4 in u16
    if: (v2 == b && v1 == c && v5 == bc) || (v2 == d && v1 == e && v5 == de) || (v2 == h && v1 == l && v5 == hl)  // canJoinRegs(%2 %1 %5)
    if: v4 == v5  // same(%4 %5)
    if: v1 != l  // not ld x, x
    if: v2 != h  // not ld x, x
    before:
        ld	v1, l
        ld	v2, h
        ld	a, #k3
        ld	(v4), a
    after:
        ld	v1, l
        ld	v2, h
        ld	(hl), #k3
    dead: A, below SP

// peeph.def:340: common peephole 25b loaded #%1 into (%8) instead of (%4).
// if canJoinRegs(%2 %1 %5), same(%4 %5), canJoinRegs(%7 %6 %8)
rule peeph-340
    for: v1 in c | e | l
    for: v2 in b | d | h
    for: v4 in hl | de | bc | sp | c | ix | iy | k4
    for: v5 in bc | de | hl
    for: v6 in c | e | l
    for: v7 in b | d | h
    for: v8 in bc | de | hl
    for: k3, k4 in u16
    if: (v2 == b && v1 == c && v5 == bc) || (v2 == d && v1 == e && v5 == de) || (v2 == h && v1 == l && v5 == hl)  // canJoinRegs(%2 %1 %5)
    if: v4 == v5  // same(%4 %5)
    if: (v7 == b && v6 == c && v8 == bc) || (v7 == d && v6 == e && v8 == de) || (v7 == h && v6 == l && v8 == hl)  // canJoinRegs(%7 %6 %8)
    if: v1 != v6  // not ld x, x
    if: v2 != v7  // not ld x, x
    before:
        ld	v1, v6
        ld	v2, v7
        ld	a, #k3
        ld	(v4), a
    after:
        ld	v1, v6
        ld	v2, v7
        ld	a, #k3
        ld	(v8), a
    dead: below SP

// peeph.def:353: common peephole 26a merged push and ex (sp), since %2 isn't used.
// if same(%2 'hl' 'ix' 'xy'), notUsed(%2)
rule peeph-353
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in hl | ix
    for: k1 in u16; o1 in s8
    if: v2 == hl || v2 == ix || v2 == 'xy'  // same(%2 'hl' 'ix' 'xy')
    before:
        push	v1
        ex	(sp), v2
    after:
        push	v2
    dead: v2, below SP

// peeph.def:361: common peephole 26b moved push after de/hl swap.
rule peeph-361
    before:
        push	de
        ex	de, hl
    after:
        ex	de, hl
        push	hl
    dead: below SP

// peeph.def:370: common peephole 26c moved push after de/hl swap.
rule peeph-370
    before:
        push	hl
        ex	de, hl
    after:
        ex	de, hl
        push	de
    dead: below SP

// peeph.def:379: common peephole 26d moved push %1 before de/hl swap.
// if notSame(%1 'hl' 'de'), notSame(%1 'bcde'), notSame(%1 'jkhl')
rule peeph-379
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: v1 != hl && v1 != de  // notSame(%1 'hl' 'de')
    if: v1 != 'bcde'  // notSame(%1 'bcde')
    if: v1 != 'jkhl'  // notSame(%1 'jkhl')
    before:
        ex	de, hl
        push	v1
    after:
        push	v1
        ex	de, hl
    dead: below SP

// peeph.def:388: common peephole 26e pushed hl directly instead of going through de.
// if notUsed('de' 'hl')
rule peeph-388
    before:
        ex	de, hl
        push	de
    after:
        push	hl
    dead: DE, HL, below SP

// peeph.def:396: common peephole 27 pushed de instead of hl removing a load.
// if notUsed('hl' 'e')
rule peeph-396
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: l != v1  // not ld x, x
    before:
        ld	l, v1
        ld	h, d
        push	hl
    after:
        ld	e, v1
        push	de
    dead: E, HL, below SP

// peeph.def:407: common peephole 28 pushed hl directly instead of going through de.
// if notSame(%1 'hl' 'de'), notUsed('de' 'hl')
rule peeph-407
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: v1 != hl && v1 != de  // notSame(%1 'hl' 'de')
    before:
        ex	de, hl
        push	v1
        push	de
    after:
        push	v1
        push	hl
    dead: DE, HL, below SP

// peeph.def:417: common peephole 29 pushed %3 directly instead of going through %6.
// if canJoinRegs(%2 %1 %3), canJoinRegs(%5 %4 %7), same(%7 %6), notUsed(%6)
rule peeph-417
    for: v1 in c | e | l
    for: v2 in b | d | h
    for: v3 in bc | de | hl
    for: v4 in c | e | l
    for: v5 in b | d | h
    for: v6 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k6 | (k6) | o6 (ix) | o6 (iy)
    for: v7 in bc | de | hl
    for: k6 in u16; o6 in s8
    if: (v2 == b && v1 == c && v3 == bc) || (v2 == d && v1 == e && v3 == de) || (v2 == h && v1 == l && v3 == hl)  // canJoinRegs(%2 %1 %3)
    if: (v5 == b && v4 == c && v7 == bc) || (v5 == d && v4 == e && v7 == de) || (v5 == h && v4 == l && v7 == hl)  // canJoinRegs(%5 %4 %7)
    if: v7 == v6  // same(%7 %6)
    if: v4 != v1  // not ld x, x
    if: v5 != v2  // not ld x, x
    before:
        ld	v4, v1
        ld	v5, v2
        push	v6
    after:
        push	v3
    dead: v6

// peeph.def:426: common peephole 30 pushed %7 directly instead of going through %4.
// if canJoinRegs(%3 %2 %5), same(%5 %4), canJoinRegs(%6 %5 %7), notSame(%1 %4), notUsed(%4)
rule peeph-426
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in c | e | l
    for: v3 in b | d | h
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: v5 in c | e | l
    for: v6 in b | d | h
    for: v7 in bc | de | hl
    for: k1, k4 in u16; o1, o4 in s8
    if: (v3 == b && v2 == c) || (v3 == d && v2 == e) || (v3 == h && v2 == l)  // canJoinRegs(%3 %2 %5)
    if: v5 == v4  // same(%5 %4)
    if: (v6 == b && v5 == c && v7 == bc) || (v6 == d && v5 == e && v7 == de) || (v6 == h && v5 == l && v7 == hl)  // canJoinRegs(%6 %5 %7)
    if: v1 != v4  // notSame(%1 %4)
    if: v2 != v5  // not ld x, x
    if: v3 != v6  // not ld x, x
    before:
        ld	v2, v5
        ld	v3, v6
        push	v1
        push	v4
    after:
        push	v1
        push	v7
    dead: v4

// peeph.def:437: common peephole 31 popped %6 directly instead of going through %1.
// if canJoinRegs(%4 %2 %6), canJoinRegs(%5 %3 %7), same(%7 %1), notUsed(%1)
rule peeph-437
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in c | e | l
    for: v3 in c | e | l
    for: v4 in b | d | h
    for: v5 in b | d | h
    for: v6 in bc | de | hl
    for: v7 in bc | de | hl
    for: k1 in u16; o1 in s8
    if: (v4 == b && v2 == c && v6 == bc) || (v4 == d && v2 == e && v6 == de) || (v4 == h && v2 == l && v6 == hl)  // canJoinRegs(%4 %2 %6)
    if: (v5 == b && v3 == c && v7 == bc) || (v5 == d && v3 == e && v7 == de) || (v5 == h && v3 == l && v7 == hl)  // canJoinRegs(%5 %3 %7)
    if: v7 == v1  // same(%7 %1)
    if: v2 != v3  // not ld x, x
    if: v4 != v5  // not ld x, x
    before:
        pop	v1
        ld	v2, v3
        ld	v4, v5
    after:
        pop	v6
    dead: v1

// peeph.def:446: common peephole 32a removed de/hl swap.
rule peeph-446
    before:
        ex	de, hl
        ld	e, l
        ld	d, h
    after:
        ld	l, e
        ld	h, d
    dead: below SP

// peeph.def:456: common peephole 32b removed de/hl swap.
rule peeph-456
    before:
        ex	de, hl
        ld	l, e
        ld	h, d
    after:
        ld	e, l
        ld	d, h
    dead: below SP

// peeph.def:466: common peephole 33 loaded %3 from %2 instead of going through %1 (%4).
// if same(%4 'ix' 'iy'), canAssign(%3 %2), notSame(%3 'bc' 'de' 'hl' 'ix' 'iy')
rule peeph-466
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | #k2 | (k2)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | (hl) | (de) | (bc) | ix | iy | (k3)
    for: v4 in ix | iy
    for: k1 in s8; k2, k3 in u16
    if: v4 == ix || v4 == iy  // same(%4 'ix' 'iy')
    if: (v3 == a && (v2 != bc && v2 != de && v2 != hl && v2 != sp && v2 != ix && v2 != iy)) || ((v3 == b || v3 == c || v3 == d || v3 == e || v3 == h || v3 == l) && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '(hl)' || v2 == '#k2')) || ((v3 == bc || v3 == de) && (v2 == '#k2' || v2 == '(k2)')) || ((v3 == hl || v3 == ix || v3 == iy) && (v2 == sp || v2 == '#k2' || v2 == '(k2)')) || (v3 == sp && (v2 == hl || v2 == ix || v2 == iy)) || (v3 == '(hl)' && (v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l || v2 == '#k2')) || ((v3 == '(de)' || v3 == '(bc)') && v2 == a) || (v3 == '(k3)' && (v2 == a || v2 == bc || v2 == de || v2 == hl || v2 == sp || v2 == ix || v2 == iy))  // canAssign(%3 %2)
    if: v3 != bc && v3 != de && v3 != hl && v3 != ix && v3 != iy  // notSame(%3 'bc' 'de' 'hl' 'ix' 'iy')
    before:
        ld	k1 (v4), v2
        ld	v3, k1 (v4)
    after:
        ld	k1 (v4), v2
        ld	v3, v2
    dead: below SP

// peeph.def:476: common peephole 34 loaded %2 from a instead of %1 (%3)
// if same(%3 'ix' 'iy'), canAssign(%2 'a')
rule peeph-476
    for: v2 in a | b | c | d | e | h | l | (hl) | (de) | (bc) | (k2)
    for: v3 in ix | iy
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k1, o4 in s8; k2, k4 in u16
    if: v3 == ix || v3 == iy  // same(%3 'ix' 'iy')
    before:
        ld	k1 (v3), a
        push	v4
        ld	v2, k1 (v3)
    after:
        ld	k1 (v3), a
        push	v4
        ld	v2, a
    dead: below SP

// peeph.def:487: common peephole 35 pushed de instead of pushing a twice.
// if notUsed('d'), notUsed('a')
rule peeph-487
    before:
        push	af
        inc	sp
        ld	a, e
        push	af
        inc	sp
    after:
        ld	d, a
        push	de
    dead: A, D, below SP

// peeph.def:499: common peephole 36 used hl instead of %2.
// if notUsed('hl' %2 'a')
rule peeph-499
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in c | bc | de | hl | sp | ix | iy
    for: k1, k3 in u16; o1 in s8
    before:
        pop	v1
        pop	v2
        push	v2
        push	v1
        ld	a, #k3
        ld	(v2), a
    after:
        pop	v1
        pop	hl
        push	hl
        push	v1
        ld	(hl), #k3
    dead: A, HL, v2

// peeph.def:515: common peephole 37a pushed %4 instead of pushing a twice.
// if unusedReg(%4 'bc' 'de' 'hl'), canSplitReg(%4 %2 %3), notUsed('a')
rule peeph-515
    for: v2 in b | d | h
    for: v3 in c | e | l
    for: v4 in bc | de | hl
    for: k1 in u16
    if: (v4 == bc && v2 == b && v3 == c) || (v4 == de && v2 == d && v3 == e) || (v4 == hl && v2 == h && v3 == l)  // canSplitReg(%4 %2 %3)
    before:
        push	af
        inc	sp
        ld	a, #k1
        push	af
        inc	sp
    after:
        ld	v2, a
        ld	v3, #k1
        push	v4
    dead: A, v4, below SP

// peeph.def:528: common peephole 37b pushed %4 instead of pushing a twice.
// if unusedReg(%4 'bc' 'de' 'hl'), canSplitReg(%4 %2 %3), notUsed('af')
rule peeph-528
    for: v2 in b | d | h
    for: v3 in c | e | l
    for: v4 in bc | de | hl
    if: (v4 == bc && v2 == b && v3 == c) || (v4 == de && v2 == d && v3 == e) || (v4 == hl && v2 == h && v3 == l)  // canSplitReg(%4 %2 %3)
    before:
        push	af
        inc	sp
        xor	a, a
        push	af
        inc	sp
    after:
        ld	v2, a
        ld	v3, #0x00
        push	v4
    dead: A, CF, HF, NF, PVF, SF, ZF, v4, below SP

// peeph.def:541: common peephole 38 combined pushing of %3 and %5.
// if canSplitReg(%1 %3 %4), canSplitReg(%2 %5), canAssign(%4 %5), notUsed(%4)
rule peeph-541
    for: v1 in bc | de | hl
    for: v2 in bc | de | hl
    for: v4 in c | e | l
    for: v5 in b | d | h
    if: (v1 == bc && v4 == c) || (v1 == de && v4 == e) || (v1 == hl && v4 == l)  // canSplitReg(%1 %3 %4)
    if: (v2 == bc && v5 == b) || (v2 == de && v5 == d) || (v2 == hl && v5 == h)  // canSplitReg(%2 %5)
    before:
        push	v1
        inc	sp
        push	v2
        inc	sp
    after:
        ld	v4, v5
        push	v1
    dead: v4, below SP

// peeph.def:552: common peephole 39 replaced 16-bit addition by 8-bit loads and 16-bit increment.
// if canSplitReg(%2 %3 %4), immdInRange(1 1 '+' %1 0 %9)
rule peeph-552
    for: v2 in bc | de | hl
    for: v3 in b | d | h
    for: v4 in c | e | l
    for: k1 in u16
    if: (v2 == bc && v3 == b && v4 == c) || (v2 == de && v3 == d && v4 == e) || (v2 == hl && v3 == h && v4 == l)  // canSplitReg(%2 %3 %4)
    if: 1 <= (k1 + 0) && (k1 + 0) <= 1  // immdInRange(1 1 '+' %1 0 %9)
    before:
        ld	hl, #k1
        add	hl, v2
    after:
        ld	l, v4
        ld	h, v3
        inc	hl
    dead: below SP

// peeph.def:562: common peephole 40a combined redundant ANDs #%1 and #%2.
// if operandsLiteral(%1 %2), immdInRange(0x00 0xFF '&' %1 %2 %x3)
rule peeph-562
    for: k1, k2, k3 in u16
    if: 0 <= (k1 & k2) && (k1 & k2) <= 255 && k3 == (k1 & k2)  // immdInRange(0x00 0xFF '&' %1 %2 %x3)
    before:
        and	a, #k1
        and	a, #k2
    after:
        and	a, #k3
    dead: below SP

// peeph.def:570: common peephole 40b combined redundant ORs #%1 and #%2.
// if operandsLiteral(%1 %2), immdInRange(0x00 0xFF '|' %1 %2 %x3)
rule peeph-570
    for: k1, k2, k3 in u16
    if: 0 <= (k1 | k2) && (k1 | k2) <= 255 && k3 == (k1 | k2)  // immdInRange(0x00 0xFF '|' %1 %2 %x3)
    before:
        or	a, #k1
        or	a, #k2
    after:
        or	a, #k3
    dead: below SP

// peeph.def:578: common peephole 41a remove double load to %1.
// if notVolatile(%1), notVolatile(%2), notSame(%1 '(hl+)' '(hl-)'), notSame(%2 '(hl+)' '(hl-)'), operandsNotRelated(%1 %3)
rule peeph-578
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: k1, k2, k3 in u16; o1, o2, o3 in s8
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v2 != '(hl+)' && v2 != '(hl-)'  // notSame(%2 '(hl+)' '(hl-)')
    if: ((v1 == a || v1 == af) && (v3 != a && v3 != af)) || ((v1 == b || v1 == c || v1 == bc) && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)')) || ((v1 == d || v1 == e || v1 == de) && (v3 != d && v3 != e && v3 != de && v3 != '(de)')) || ((v1 == h || v1 == l || v1 == hl) && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)')) || (v1 == sp && v3 != sp) || (v1 == '(hl)' && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)' && v3 != '(k3)')) || (v1 == '(de)' && (v3 != d && v3 != e && v3 != de && v3 != '(de)' && v3 != '(k3)')) || (v1 == '(bc)' && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)' && v3 != '(k3)')) || (v1 == ix && (v3 != ix && v3 != 'o3 (ix)')) || (v1 == iy && (v3 != iy && v3 != 'o3 (iy)')) || (v1 == '#k1' && (v3 != '#k3' || (v3 == '#k3' && !(k3 == k1)))) || (v1 == '(k1)' && v3 != '(k3)') || (v1 == 'o1 (ix)' && (v3 != ix && v3 != '(k3)' && v3 != 'o3 (ix)')) || (v1 == 'o1 (iy)' && (v3 != iy && v3 != '(k3)' && v3 != 'o3 (iy)'))  // operandsNotRelated(%1 %3)
    if: v1 != v2  // not ld x, x
    if: v1 != v3  // not ld x, x
    before:
        ld	v1, v2
        ld	v1, v3
    after:
        ld	v1, v3
    dead: below SP

// peeph.def:586: common peephole 42 combined pushing of a and c.
// if notUsed('b'), notUsed('a')
rule peeph-586
    before:
        push	af
        inc	sp
        ld	a, c
        push	af
        inc	sp
    after:
        ld	b, a
        push	bc
    dead: A, B, below SP

// peeph.def:598: common peephole 43 combined pushing of %3 and %2.
// if notSame(%1 'iy'), canSplitReg(%1 %3 %4), canAssign(%4 %2), notUsed(%4 'a')
rule peeph-598
    for: v1 in bc | de | hl
    for: v2 in a | b | c | d | e | h | l | (hl) | #k2
    for: v4 in c | e | l
    for: k2 in u16
    if: v1 != iy  // notSame(%1 'iy')
    if: (v1 == bc && v4 == c) || (v1 == de && v4 == e) || (v1 == hl && v4 == l)  // canSplitReg(%1 %3 %4)
    if: a != v2  // not ld x, x
    before:
        push	v1
        inc	sp
        ld	a, v2
        push	af
        inc	sp
    after:
        ld	v4, v2
        push	v1
    dead: A, v4, below SP

// peeph.def:610: common peephole 44a combined pushing of %1 and %2 (%3).
// if unusedReg(%6 'bc' 'de' 'hl'), canSplitReg(%6 %4 %5), canAssign(%4 %1), notUsed('a')
rule peeph-610
    for: v1 in a | b | c | d | e | h | l | (hl) | #k1
    for: v3 in ix | iy
    for: v4 in b | d | h
    for: v5 in c | e | l
    for: v6 in bc | de | hl
    for: k1 in u16; k2 in s8
    if: (v6 == bc && v4 == b && v5 == c) || (v6 == de && v4 == d && v5 == e) || (v6 == hl && v4 == h && v5 == l)  // canSplitReg(%6 %4 %5)
    if: a != v1  // not ld x, x
    before:
        ld	a, v1
        push	af
        inc	sp
        ld	a, k2 (v3)
        push	af
        inc	sp
    after:
        ld	v4, v1
        ld	v5, k2 (v3)
        push	v6
    dead: A, v6, below SP

// peeph.def:624: common peephole 44b combined pushing of (%1) and (%2).
// if unusedReg(%6 'bc' 'de' 'hl'), notSame(%6 %1 %2), canSplitReg(%6 %4 %5)
rule peeph-624
    for: v1 in hl | de | bc | sp | c | ix | iy | k1
    for: v2 in hl | de | bc | sp | c | ix | iy | k2
    for: v4 in b | d | h
    for: v5 in c | e | l
    for: v6 in bc | de | hl
    for: k1, k2 in u16
    if: v6 != v1 && v6 != v2 && v1 != v2  // notSame(%6 %1 %2)
    if: (v6 == bc && v4 == b && v5 == c) || (v6 == de && v4 == d && v5 == e) || (v6 == hl && v4 == h && v5 == l)  // canSplitReg(%6 %4 %5)
    before:
        ld	a, (v1)
        push	af
        inc	sp
        ld	a, (v2)
        push	af
        inc	sp
    after:
        ld	a, (v1)
        ld	v4, a
        ld	a, (v2)
        ld	v5, a
        push	v6
    dead: v6, below SP

// peeph.def:654: common peephole 47a pushed %1 (%3), %2 (%3) through %6 instead of af.
// if unusedReg(%6 'bc' 'de' 'hl'), canSplitReg(%6 %4 %5), notUsed('a')
rule peeph-654
    for: v3 in ix | iy
    for: v4 in b | d | h
    for: v5 in c | e | l
    for: v6 in bc | de | hl
    for: k1, k2 in s8
    if: (v6 == bc && v4 == b && v5 == c) || (v6 == de && v4 == d && v5 == e) || (v6 == hl && v4 == h && v5 == l)  // canSplitReg(%6 %4 %5)
    before:
        ld	a, k1 (v3)
        push	af
        inc	sp
        ld	a, k2 (v3)
        push	af
        inc	sp
    after:
        ld	v4, k1 (v3)
        ld	v5, k2 (v3)
        push	v6
    dead: A, v6, below SP

// peeph.def:668: common peephole 47b pushed (hl), %1, (hl) through %4 instead of af.
// if same(%1 'inc' 'dec'), unusedReg(%4 'bc' 'de'), canSplitReg(%4 %2 %3), notUsed('a')
rule peeph-668
    for: v1 in inc | dec
    for: v2 in b | d
    for: v3 in c | e
    for: v4 in bc | de
    if: v1 == 'inc' || v1 == 'dec'  // same(%1 'inc' 'dec')
    if: (v4 == bc && v2 == b && v3 == c) || (v4 == de && v2 == d && v3 == e)  // canSplitReg(%4 %2 %3)
    before:
        ld	a, (hl)
        push	af
        inc	sp
        v1	hl
        ld	a, (hl)
        push	af
        inc	sp
    after:
        ld	a, (hl)
        v1	hl
        ld	v2, a
        ld	a, (hl)
        ld	v3, a
        push	v4
    dead: A, v4, below SP

// peeph.def:686: common peephole 47c pushed (%5), (%6) through %4 instead of af.
// if same(%5 'hl' 'hl+' 'hl-'), same(%6 'hl' 'hl+' 'hl-'), unusedReg(%4 'bc' 'de'), canSplitReg(%4 %2 %3)
rule peeph-686
    for: v2 in b | d
    for: v3 in c | e
    for: v4 in bc | de
    for: v5 in hl
    for: v6 in hl
    if: v5 == hl || v5 == 'hl+' || v5 == 'hl-'  // same(%5 'hl' 'hl+' 'hl-')
    if: v6 == hl || v6 == 'hl+' || v6 == 'hl-'  // same(%6 'hl' 'hl+' 'hl-')
    if: (v4 == bc && v2 == b && v3 == c) || (v4 == de && v2 == d && v3 == e)  // canSplitReg(%4 %2 %3)
    before:
        ld	a, (v5)
        push	af
        inc	sp
        ld	a, (v6)
        push	af
        inc	sp
    after:
        ld	a, (v5)
        ld	v2, a
        ld	a, (v6)
        ld	v3, a
        push	v4
    dead: v4, below SP

// peeph.def:702: common peephole 48 pushed %6 instead of %3.
// if canJoinRegs(%2 %1 %7), same(%3 %7), canJoinRegs(%5 %4 %6), notUsed(%3)
rule peeph-702
    for: v1 in c | e | l
    for: v2 in b | d | h
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in c | e | l
    for: v5 in b | d | h
    for: v6 in bc | de | hl
    for: v7 in bc | de | hl
    for: k3 in u16; o3 in s8
    if: (v2 == b && v1 == c && v7 == bc) || (v2 == d && v1 == e && v7 == de) || (v2 == h && v1 == l && v7 == hl)  // canJoinRegs(%2 %1 %7)
    if: v3 == v7  // same(%3 %7)
    if: (v5 == b && v4 == c && v6 == bc) || (v5 == d && v4 == e && v6 == de) || (v5 == h && v4 == l && v6 == hl)  // canJoinRegs(%5 %4 %6)
    if: v1 != v4  // not ld x, x
    if: v2 != v5  // not ld x, x
    before:
        ld	v1, v4
        ld	v2, v5
        push	v3
    after:
        push	v6
    dead: v3

// peeph.def:711: common peephole 49 pushed %3 instead of hl.
// if same(%4 'inc' 'dec'), unusedReg(%3 'de' 'bc'), canSplitReg(%3 %2 %1), notUsed('hl'), notUsed('a')
rule peeph-711
    for: v1 in c | e
    for: v2 in b | d
    for: v3 in de | bc
    for: v4 in inc | dec
    if: v4 == 'inc' || v4 == 'dec'  // same(%4 'inc' 'dec')
    if: (v3 == de && v2 == d && v1 == e) || (v3 == bc && v2 == b && v1 == c)  // canSplitReg(%3 %2 %1)
    before:
        ld	a, (hl)
        v4	hl
        ld	h, (hl)
        ld	l, a
        push	hl
    after:
        ld	v1, (hl)
        v4	hl
        ld	v2, (hl)
        push	v3
    dead: A, HL, v3, below SP

// peeph.def:725: common peephole 49a pushed %2 instead of %3.
// if same(%3 'ix' 'iy'), notUsed(%3), unusedReg(%2 'bc' 'de' 'hl'), canAssign(%2 %1)
rule peeph-725
    for: v1 in sp | #k1 | (k1)
    for: v2 in bc | de | hl
    for: v3 in ix | iy
    for: k1 in u16
    if: v3 == ix || v3 == iy  // same(%3 'ix' 'iy')
    if: (v2 != hl && v1 != sp) || v2 == hl  // canAssign(%2 %1)
    if: v3 != v1  // not ld x, x
    before:
        ld	v3, v1
        push	v3
    after:
        ld	v2, v1
        push	v2
    dead: v3, v2, below SP

// peeph.def:734: common peephole 50a eliminated dead pop/push %1 pair.
// if notUsed(%1)
rule peeph-734
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        pop	v1
        push	v1
    after:
    dead: v1

// peeph.def:741: common peephole 50b eliminated dead push/pop pair.
rule peeph-741
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        push	v1
        pop	v1
    after:
    dead: below SP

// peeph.def:748: common peephole 50c eliminated dead push/inc sp pair.
rule peeph-748
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        push	v1
        inc	sp
        inc	sp
    after:
    dead: below SP

// peeph.def:756: common peephole 51 eliminated dead pop/push %1 pair.
// if notUsed(%1), operandsNotRelated(%1 %3)
rule peeph-756
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: k1, k3 in u16; k2, o1, o3 in s8
    if: ((v1 == a || v1 == af) && (v3 != a && v3 != af)) || ((v1 == b || v1 == c || v1 == bc) && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)')) || ((v1 == d || v1 == e || v1 == de) && (v3 != d && v3 != e && v3 != de && v3 != '(de)')) || ((v1 == h || v1 == l || v1 == hl) && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)')) || (v1 == sp && v3 != sp) || (v1 == '(hl)' && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)' && v3 != '(k3)')) || (v1 == '(de)' && (v3 != d && v3 != e && v3 != de && v3 != '(de)' && v3 != '(k3)')) || (v1 == '(bc)' && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)' && v3 != '(k3)')) || (v1 == ix && (v3 != ix && v3 != 'o3 (ix)')) || (v1 == iy && (v3 != iy && v3 != 'o3 (iy)')) || (v1 == '#k1' && (v3 != '#k3' || (v3 == '#k3' && !(k3 == k1)))) || (v1 == '(k1)' && v3 != '(k3)') || (v1 == 'o1 (ix)' && (v3 != ix && v3 != '(k3)' && v3 != 'o3 (ix)')) || (v1 == 'o1 (iy)' && (v3 != iy && v3 != '(k3)' && v3 != 'o3 (iy)'))  // operandsNotRelated(%1 %3)
    before:
        pop	v1
        ld	k2 (ix), v3
        push	v1
    after:
        ld	k2 (ix), v3
    dead: v1

// peeph.def:765: common peephole 51a eliminated dead pop/push %1 pair.
// if notUsed(%1), operandsNotRelated(%1 %3), operandsNotRelated(%1 %2), notSame(%2 %3 '(sp)')
rule peeph-765
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: k1, k2, k3 in u16; o1, o2, o3 in s8
    if: ((v1 == a || v1 == af) && (v3 != a && v3 != af)) || ((v1 == b || v1 == c || v1 == bc) && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)')) || ((v1 == d || v1 == e || v1 == de) && (v3 != d && v3 != e && v3 != de && v3 != '(de)')) || ((v1 == h || v1 == l || v1 == hl) && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)')) || (v1 == sp && v3 != sp) || (v1 == '(hl)' && (v3 != h && v3 != l && v3 != hl && v3 != '(hl)' && v3 != '(k3)')) || (v1 == '(de)' && (v3 != d && v3 != e && v3 != de && v3 != '(de)' && v3 != '(k3)')) || (v1 == '(bc)' && (v3 != b && v3 != c && v3 != bc && v3 != '(bc)' && v3 != '(k3)')) || (v1 == ix && (v3 != ix && v3 != 'o3 (ix)')) || (v1 == iy && (v3 != iy && v3 != 'o3 (iy)')) || (v1 == '#k1' && (v3 != '#k3' || (v3 == '#k3' && !(k3 == k1)))) || (v1 == '(k1)' && v3 != '(k3)') || (v1 == 'o1 (ix)' && (v3 != ix && v3 != '(k3)' && v3 != 'o3 (ix)')) || (v1 == 'o1 (iy)' && (v3 != iy && v3 != '(k3)' && v3 != 'o3 (iy)'))  // operandsNotRelated(%1 %3)
    if: ((v1 == a || v1 == af) && (v2 != a && v2 != af)) || ((v1 == b || v1 == c || v1 == bc) && (v2 != b && v2 != c && v2 != bc && v2 != '(bc)')) || ((v1 == d || v1 == e || v1 == de) && (v2 != d && v2 != e && v2 != de && v2 != '(de)')) || ((v1 == h || v1 == l || v1 == hl) && (v2 != h && v2 != l && v2 != hl && v2 != '(hl)')) || (v1 == sp && v2 != sp) || (v1 == '(hl)' && (v2 != h && v2 != l && v2 != hl && v2 != '(hl)' && v2 != '(k2)')) || (v1 == '(de)' && (v2 != d && v2 != e && v2 != de && v2 != '(de)' && v2 != '(k2)')) || (v1 == '(bc)' && (v2 != b && v2 != c && v2 != bc && v2 != '(bc)' && v2 != '(k2)')) || (v1 == ix && (v2 != ix && v2 != 'o2 (ix)')) || (v1 == iy && (v2 != iy && v2 != 'o2 (iy)')) || (v1 == '#k1' && (v2 != '#k2' || (v2 == '#k2' && !(k2 == k1)))) || (v1 == '(k1)' && v2 != '(k2)') || (v1 == 'o1 (ix)' && (v2 != ix && v2 != '(k2)' && v2 != 'o2 (ix)')) || (v1 == 'o1 (iy)' && (v2 != iy && v2 != '(k2)' && v2 != 'o2 (iy)'))  // operandsNotRelated(%1 %2)
    if: v2 != v3 && v2 != '(sp)' && v3 != '(sp)'  // notSame(%2 %3 '(sp)')
    if: v2 != v3  // not ld x, x
    before:
        pop	v1
        ld	v2, v3
        push	v1
    after:
        ld	v2, v3
    dead: v1

// peeph.def:774: common peephole 52a replaced push/pop pair by loads.
// if canSplitReg(%1 %3 %4), canSplitReg(%2 %5 %6), notSame(%1 %2 'ix' 'iy'), notUsed(%1)
rule peeph-774
    for: v1 in bc | de | hl
    for: v2 in bc | de | hl
    for: v3 in b | d | h
    for: v4 in c | e | l
    for: v5 in b | d | h
    for: v6 in c | e | l
    if: (v1 == bc && v3 == b && v4 == c) || (v1 == de && v3 == d && v4 == e) || (v1 == hl && v3 == h && v4 == l)  // canSplitReg(%1 %3 %4)
    if: (v2 == bc && v5 == b && v6 == c) || (v2 == de && v5 == d && v6 == e) || (v2 == hl && v5 == h && v6 == l)  // canSplitReg(%2 %5 %6)
    if: v1 != v2 && v1 != ix && v1 != iy && v2 != ix && v2 != iy  // notSame(%1 %2 'ix' 'iy')
    before:
        push	v1
        pop	v2
    after:
        ld	v6, v4
        ld	v5, v3
    dead: v1, below SP

// peeph.def:783: common peephole 52b replaced push/pop pair by load.
// if canSplitReg(%1 %3 %4), notUsed('f')
rule peeph-783
    for: v1 in bc | de | hl
    for: v3 in b | d | h
    if: (v1 == bc && v3 == b) || (v1 == de && v3 == d) || (v1 == hl && v3 == h)  // canSplitReg(%1 %3 %4)
    before:
        push	v1
        pop	af
    after:
        ld	a, v3
    dead: CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:791: common peephole 52c replaced push/pop pair by loads.
// if canSplitReg(%1 %3 %4), canSplitReg(%2 %5 %6), notSame(%1 %2 'ix' 'iy'), operandsNotRelated(%7 %1)
rule peeph-791
    for: v1 in bc | de | hl
    for: v2 in bc | de | hl
    for: v3 in b | d | h
    for: v4 in c | e | l
    for: v5 in b | d | h
    for: v6 in c | e | l
    for: v7 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k7 | (k7) | o7 (ix) | o7 (iy)
    for: k7 in u16; o7 in s8
    if: (v1 == bc && v3 == b && v4 == c) || (v1 == de && v3 == d && v4 == e) || (v1 == hl && v3 == h && v4 == l)  // canSplitReg(%1 %3 %4)
    if: (v2 == bc && v5 == b && v6 == c) || (v2 == de && v5 == d && v6 == e) || (v2 == hl && v5 == h && v6 == l)  // canSplitReg(%2 %5 %6)
    if: v1 != v2 && v1 != ix && v1 != iy && v2 != ix && v2 != iy  // notSame(%1 %2 'ix' 'iy')
    if: (v7 == a || v7 == sp || v7 == af || v7 == ix || v7 == iy || v7 == '#k7' || v7 == '(k7)' || v7 == 'o7 (ix)' || v7 == 'o7 (iy)') || ((v7 == b || v7 == c || v7 == bc || v7 == '(bc)') && v1 != bc) || ((v7 == d || v7 == e || v7 == de || v7 == '(de)') && v1 != de) || ((v7 == h || v7 == l || v7 == hl || v7 == '(hl)') && v1 != hl)  // operandsNotRelated(%7 %1)
    if: v1 != v7  // not ld x, x
    before:
        push	v1
        ld	v1, v7
        pop	v2
    after:
        ld	v6, v4
        ld	v5, v3
        ld	v1, v7
    dead: below SP

// peeph.def:802: common peephole 53d used hl instead of bc for pop/push.
// if notUsed('bc')
rule peeph-802
    before:
        pop	bc
        push	bc
        ld	l, c
        ld	h, b
    after:
        pop	hl
        push	hl
    dead: BC, below SP

// peeph.def:814: common peephole 53 used direct memory load instead of indirect.
// if isPort('z80' 'z80n' 'z180' 'r2k' 'r2ka' 'r3ka' 'r4k' 'r5k' 'r6k' 'sm83' 'ez80' 'r800'), notUsed(%3 'a')
rule peeph-814
    for: v3 in ix | iy
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k1, k4 in u16; k2 in -128..65535; o4 in s8; x0 in -32768..65535
    if: x0 == k1 + k2
    before:
        ld	v3, #k1
        ld	v4, k2 (v3)
    after:
        ld	a, (x0)
        ld	v4, a
    dead: A, v3, below SP

// peeph.def:823: common peephole 54 used hl instead of %4.
// if notUsed(%4 'hl'), same(%5 'a' 'b' 'c' 'd' 'e' 'h' 'l'), same(%3 'add' 'adc' 'and' 'ld' 'or' 'sbc' 'sub' 'xor')
rule peeph-823
    for: v3 in add | adc | and | ld | or | sbc | sub | xor
    for: v4 in ix | iy
    for: v5 in a | b | c | d | e | h | l
    for: k1 in u16; k2 in -128..65535; x0 in -32768..65535
    if: v5 == a || v5 == b || v5 == c || v5 == d || v5 == e || v5 == h || v5 == l  // same(%5 'a' 'b' 'c' 'd' 'e' 'h' 'l')
    if: v3 == 'add' || v3 == 'adc' || v3 == 'and' || v3 == 'ld' || v3 == 'or' || v3 == 'sbc' || v3 == 'sub' || v3 == 'xor'  // same(%3 'add' 'adc' 'and' 'ld' 'or' 'sbc' 'sub' 'xor')
    if: x0 == k1 + k2
    before:
        ld	v4, #k1
        v3	v5, k2 (v4)
    after:
        ld	hl, #x0
        v3	v5, (hl)
    dead: HL, v4, below SP

// peeph.def:832: common peephole 55l used hl instead of %4.
// if notUsed(%4 'h')
rule peeph-832
    for: v4 in ix | iy
    for: k1 in u16; k3 in -128..65535; x0 in -32768..65535
    if: x0 == k1 + k3
    before:
        ld	v4, #k1
        ld	l, k3 (v4)
    after:
        ld	hl, #x0
        ld	l, (hl)
    dead: H, v4, below SP

// peeph.def:841: common peephole 55 used hl instead of %4.
// if notUsed(%4 'l')
rule peeph-841
    for: v4 in ix | iy
    for: k1 in u16; k3 in -128..65535; x0 in -32768..65535
    if: x0 == k1 + k3
    before:
        ld	v4, #k1
        ld	h, k3 (v4)
    after:
        ld	hl, #x0
        ld	h, (hl)
    dead: L, v4, below SP

// peeph.def:851: common peephole 56 used hl instead of %4.
// if isPort('z80' 'z80n' 'z180' 'r2k' 'r2ka' 'r3ka' 'r4k' 'r5k' 'r6k' 'sm83' 'ez80' 'r800'), notUsed(%4 'hl'), notSame(%3 'h' 'l')
rule peeph-851
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in ix | iy
    for: k1, k3 in u16; k2 in -128..65535; o3 in s8; x0 in -32768..65535
    if: v3 != h && v3 != l  // notSame(%3 'h' 'l')
    if: x0 == k1 + k2
    before:
        ld	v4, #k1
        ld	k2 (v4), v3
    after:
        ld	hl, #x0
        ld	(hl), v3
    dead: HL, v4, below SP

// peeph.def:861: common peephole 57 used direct memory store instead of indirect.
// if isPort('z80' 'z80n' 'z180' 'r2k' 'r2ka' 'r3ka' 'r4k' 'r5k' 'r6k' 'sm83' 'ez80' 'r800'), notUsed('a' %4)
rule peeph-861
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in ix | iy
    for: k1, k3 in u16; k2 in -128..65535; o3 in s8; x0 in -32768..65535
    if: x0 == k1 + k2
    before:
        ld	v4, #k1
        ld	k2 (v4), v3
    after:
        ld	a, v3
        ld	(x0), a
    dead: A, v4, below SP

// peeph.def:870: common peephole 58 used hl instead of %4.
// if operandsNotRelated(%2 'hl'), operandsNotRelated(%3 'hl'), immdInRange(-128 127 '+' %5 1 %7), same(%6 %7), notUsed(%4 'hl')
rule peeph-870
    for: v2 in a | b | c | d | e | bc | de | sp | af | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | bc | de | sp | af | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in ix | iy
    for: k1, k2, k3 in u16; k5 in -128..65535; k6, o2, o3 in s8; k7 in -128..127; x0 in -32768..65535
    if: -128 <= (k5 + 1) && (k5 + 1) <= 127 && k7 == (k5 + 1)  // immdInRange(-128 127 '+' %5 1 %7)
    if: k6 == k7  // same(%6 %7)
    if: x0 == k1 + k5
    before:
        ld	v4, #k1
        ld	v2, k5 (v4)
        ld	v3, k6 (v4)
    after:
        ld	hl, #x0
        ld	v2, (hl)
        inc	hl
        ld	v3, (hl)
    dead: HL, v4, below SP

// peeph.def:882: common peephole 59 used hl instead of %4.
// if notUsed(%4 'h')
rule peeph-882
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in ix | iy
    for: k1, k3 in u16; k2 in -128..65535; o3 in s8; x0 in -32768..65535
    if: x0 == k1 + k2
    before:
        ld	v4, #k1
        ld	k2 (v4), v3
        ld	l, k2 (v4)
    after:
        ld	hl, #x0
        ld	(hl), v3
        ld	l, (hl)
    dead: H, v4, below SP

// peeph.def:893: common peephole 60 used hl instead of %3.
// if notUsed(%3 'hl'), operandsNotRelated(%4 'hl')
rule peeph-893
    for: v3 in ix | iy
    for: v4 in a | b | c | d | e | bc | de | sp | af | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k1, k4 in u16; k2 in -128..65535; o4 in s8; x0 in -32768..65535
    if: x0 == k1 + k2
    before:
        ld	v3, #k1
        ld	k2 (v3), v4
    after:
        ld	hl, #x0
        ld	(hl), v4
    dead: HL, v3, below SP

// peeph.def:902: common peephole 61 used hl instead of %4.
// if same(%5 'bit' 'res' 'set'), notUsed(%4 'hl')
rule peeph-902
    for: v2 in 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7
    for: v4 in ix | iy
    for: v5 in bit | res | set
    for: k1 in u16; k3 in -128..65535; x0 in -32768..65535
    if: v5 == 'bit' || v5 == 'res' || v5 == 'set'  // same(%5 'bit' 'res' 'set')
    if: x0 == k1 + k3
    before:
        ld	v4, #k1
        v5	v2, k3 (v4)
    after:
        ld	hl, #x0
        v5	v2, (hl)
    dead: HL, v4, below SP

// peeph.def:911: common peephole 62 used hl instead of %4.
// if operandsNotRelated(%2 'hl'), immdInRange(-128 127 '+' %5 1 %7), same(%7 %6), notUsed(%4 'hl')
rule peeph-911
    for: v2 in a | b | c | d | e | bc | de | sp | af | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in ix | iy
    for: k1, k2, k3 in u16; k5 in -128..65535; k6, o2, o3 in s8; k7 in -128..127; x0 in -32768..65535
    if: -128 <= (k5 + 1) && (k5 + 1) <= 127 && k7 == (k5 + 1)  // immdInRange(-128 127 '+' %5 1 %7)
    if: k7 == k6  // same(%7 %6)
    if: x0 == k1 + k5
    before:
        ld	v4, #k1
        add	v4, sp
        ld	v2, k5 (v4)
        ld	v3, k6 (v4)
    after:
        ld	hl, #x0
        add	hl, sp
        ld	v2, (hl)
        inc	hl
        ld	v3, (hl)
    dead: HL, v4, below SP

// peeph.def:925: common peephole 63 used hl instead of %4.
// if notUsed(%4 'hl')
rule peeph-925
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v4 in ix | iy
    for: k1, k2 in u16; k3 in -128..65535; o2 in s8; x0 in -32768..65535
    if: x0 == k1 + k3
    before:
        ld	v4, #k1
        add	v4, sp
        ld	v2, k3 (v4)
    after:
        ld	hl, #x0
        add	hl, sp
        ld	v2, (hl)
    dead: HL, v4, below SP

// peeph.def:936: common peephole 64 used hl instead of %4.
// if immdInRange(-128 127 '+' %2 1 %5), same(%5 %3), notUsed(%4 'a')
rule peeph-936
    for: v4 in ix | iy
    for: k1 in u16; k2 in -128..65535; k3 in s8; k5 in -128..127; x0 in -32768..65535
    if: -128 <= (k2 + 1) && (k2 + 1) <= 127 && k5 == (k2 + 1)  // immdInRange(-128 127 '+' %2 1 %5)
    if: k5 == k3  // same(%5 %3)
    if: x0 == k1 + k2
    before:
        ld	v4, #k1
        add	v4, sp
        ld	l, k2 (v4)
        ld	h, k3 (v4)
    after:
        ld	hl, #x0
        add	hl, sp
        ld	a, (hl)
        inc	hl
        ld	h, (hl)
        ld	l, a
    dead: A, v4, below SP

// peeph.def:951: common peephole 65 used hl instead of %4.
// if immdInRange(-128 127 '+' %5 1 %7), same(%7 %6), notUsed(%4 'hl')
rule peeph-951
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k1, k2, k3, k4 in u16; k5 in -128..65535; k6, o4 in s8; k7 in -128..127; x0 in -32768..65535
    if: -128 <= (k5 + 1) && (k5 + 1) <= 127 && k7 == (k5 + 1)  // immdInRange(-128 127 '+' %5 1 %7)
    if: k7 == k6  // same(%7 %6)
    if: x0 == k1 + k5
    before:
        ld	v4, #k1
        add	v4, sp
        ld	k5 (iy), #k2
        ld	k6 (iy), #k3
    after:
        ld	hl, #x0
        add	hl, sp
        ld	(hl), #k2
        inc	hl
        ld	(hl), #k3
    dead: HL, v4

// peeph.def:965: common peephole 66a used hl instead of %4.
// if immdInRange(-128 127 '+' %2 1 %5), same(%5 %3), notUsed(%4 'hl')
rule peeph-965
    for: v4 in ix | iy
    for: k1 in u16; k2 in -128..65535; k3 in s8; k5 in -128..127; x0 in -32768..65535
    if: -128 <= (k2 + 1) && (k2 + 1) <= 127 && k5 == (k2 + 1)  // immdInRange(-128 127 '+' %2 1 %5)
    if: k5 == k3  // same(%5 %3)
    if: x0 == k1 + k2
    before:
        ld	v4, #k1
        add	v4, sp
        ld	a, k2 (v4)
        or	a, k3 (v4)
    after:
        ld	hl, #x0
        add	hl, sp
        ld	a, (hl)
        inc	hl
        or	a, (hl)
    dead: HL, v4, below SP

// peeph.def:979: common peephole 66b used hl instead of %4.
// if immdInRange(-128 127 '-' %2 1 %5), same(%5 %3), notUsed(%4 'hl')
rule peeph-979
    for: v4 in ix | iy
    for: k1 in u16; k2 in s8; k3 in -128..65535; k5 in -128..127; x0 in -32768..65535
    if: -128 <= (k2 - 1) && (k2 - 1) <= 127 && k5 == (k2 - 1)  // immdInRange(-128 127 '-' %2 1 %5)
    if: k5 == k3  // same(%5 %3)
    if: x0 == k1 + k3
    before:
        ld	v4, #k1
        add	v4, sp
        ld	a, k2 (v4)
        or	a, k3 (v4)
    after:
        ld	hl, #x0
        add	hl, sp
        ld	a, (hl)
        inc	hl
        or	a, (hl)
    dead: HL, v4, below SP

// peeph.def:993: common peephole 67a used hl instead of %4.
// if same(%5 'bit' 'res' 'set'), notUsed(%4 'hl')
rule peeph-993
    for: v2 in 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7
    for: v4 in ix | iy
    for: v5 in bit | res | set
    for: k1 in u16; k3 in -128..65535; x0 in -32768..65535
    if: v5 == 'bit' || v5 == 'res' || v5 == 'set'  // same(%5 'bit' 'res' 'set')
    if: x0 == k1 + k3
    before:
        ld	v4, #k1
        add	v4, sp
        v5	v2, k3 (v4)
    after:
        ld	hl, #x0
        add	hl, sp
        v5	v2, (hl)
    dead: HL, v4, below SP

// peeph.def:1004: common peephole 67b used hl instead of %4.
// if same(%5 'adc' 'add' 'and' 'ld' 'or' 'sbc' 'sub' 'xor'), notUsed(%4 'hl')
rule peeph-1004
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in ix | iy
    for: v5 in adc | add | and | ld | or | sbc | sub | xor
    for: k1, k3 in u16; k2 in -128..65535; o3 in s8; x0 in -32768..65535
    if: v5 == 'adc' || v5 == 'add' || v5 == 'and' || v5 == 'ld' || v5 == 'or' || v5 == 'sbc' || v5 == 'sub' || v5 == 'xor'  // same(%5 'adc' 'add' 'and' 'ld' 'or' 'sbc' 'sub' 'xor')
    if: x0 == k1 + k2
    before:
        ld	v4, #k1
        add	v4, sp
        v5	v3, k2 (v4)
    after:
        ld	hl, #x0
        add	hl, sp
        v5	v3, (hl)
    dead: HL, v4, below SP

// peeph.def:1015: common peephole 67c removed load back from stack.
// if operandsLiteral(%1), immdInRange(0 0 '+' %1 0 %2), notUsed('a')
rule peeph-1015
    for: k1 in u16
    if: 0 <= (k1 + 0) && (k1 + 0) <= 0  // immdInRange(0 0 '+' %1 0 %2)
    before:
        push	hl
        ld	hl, #k1
        add	hl, sp
        ld	a, (hl)
        inc	hl
        ld	h, (hl)
        ld	l, a
    after:
        push	hl
    dead: A, below SP

// peeph.def:1028: common peephole 68 reversed ld and or.
// if notUsed('hl')
rule peeph-1028
    before:
        inc	hl
        ld	a, (hl)
        dec	hl
        or	a, (hl)
    after:
        ld	a, (hl)
        inc	hl
        or	a, (hl)
    dead: HL, below SP

// peeph.def:1041: common peephole 69 incremented in hl instead of %3.
// if canJoinRegs(%2 %1 %4), same(%4 %3), notUsed('hl')
rule peeph-1041
    for: v1 in c | e | l
    for: v2 in b | d | h
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in bc | de | hl
    for: k3 in u16; o3 in s8
    if: (v2 == b && v1 == c && v4 == bc) || (v2 == d && v1 == e && v4 == de) || (v2 == h && v1 == l && v4 == hl)  // canJoinRegs(%2 %1 %4)
    if: v4 == v3  // same(%4 %3)
    if: v1 != l  // not ld x, x
    if: v2 != h  // not ld x, x
    before:
        ld	v1, l
        ld	v2, h
        inc	v3
    after:
        inc	hl
        ld	v1, l
        ld	v2, h
    dead: HL, below SP

// peeph.def:1052: common peephole 70 %3 (hl) instead of %2 (%4).
// if same(%3 'inc' 'dec'), notUsed(%4 'hl')
rule peeph-1052
    for: v3 in inc | dec
    for: v4 in ix | iy
    for: k1 in u16; k2 in -128..65535; x0 in -32768..65535
    if: v3 == 'inc' || v3 == 'dec'  // same(%3 'inc' 'dec')
    if: x0 == k1 + k2
    before:
        ld	v4, #k1
        v3	k2 (v4)
    after:
        ld	hl, #x0
        v3	(hl)
    dead: HL, v4, below SP

// peeph.def:1061: common peephole 71 eliminate unnecessary initialization of %1 register.
// if same(%1 'c' 'e' 'l' 'ixl' 'iyl'), canJoinRegs('' %1 %4), same(%3 %4), notUsed(%1)
rule peeph-1061
    for: v1 in c | e | l
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in bc | de | hl
    for: k2, k3 in u16; o2, o3 in s8
    if: v1 == c || v1 == e || v1 == l || v1 == ixl || v1 == iyl  // same(%1 'c' 'e' 'l' 'ixl' 'iyl')
    if: (v1 == c && v4 == bc) || (v1 == e && v4 == de) || (v1 == l && v4 == hl)  // canJoinRegs('' %1 %4)
    if: v3 == v4  // same(%3 %4)
    if: v1 != v2  // not ld x, x
    before:
        ld	v1, v2
        push	v3
        inc	sp
    after:
        push	v3
        inc	sp
    dead: v1, below SP

// peeph.def:1071: common peephole 72 tested bit %3 of %1 (%2) directly instead of going through a.
// if notUsed('a')
rule peeph-1071
    for: v2 in ix | iy
    for: v3 in 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7
    for: k1 in s8
    before:
        ld	a, k1 (v2)
        bit	v3, a
    after:
        bit	v3, k1 (v2)
    dead: A, below SP

// peeph.def:1079: common peephole 73 tested bit %2 of (hl) directly instead of going through %1.
// if notUsed(%1)
rule peeph-1079
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7
    for: k1 in u16; o1 in s8
    before:
        ld	v1, (hl)
        bit	v2, v1
    after:
        bit	v2, (hl)
    dead: v1

// peeph.def:1087: common peephole 74 tested bit %2 of %1 directly instead of going through a.
// if notUsed('a'), canAssign(%1 'b')
rule peeph-1087
    for: v1 in a | b | c | d | e | h | l | (hl)
    for: v2 in 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7
    if: a != v1  // not ld x, x
    before:
        ld	a, v1
        bit	v2, a
    after:
        bit	v2, v1
    dead: A, below SP

// peeph.def:1095: common peephole 75 %3 bit %2 of %1 directly instead of going through a.
// if same(%3 'set' 'res'), canAssign(%1 'b'), notSame(%1 '(hl+)' '(hl-)')
rule peeph-1095
    for: v1 in a | b | c | d | e | h | l | (hl)
    for: v2 in 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7
    for: v3 in set | res
    if: v3 == 'set' || v3 == 'res'  // same(%3 'set' 'res')
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: a != v1  // not ld x, x
    if: v1 != a  // not ld x, x
    before:
        ld	a, v1
        v3	v2, a
        ld	v1, a
    after:
        v3	v2, v1
        ld	a, v1
    dead: below SP

// peeph.def:1106: common peephole 76 %4 bit %3 of %1 (%2) directly instead of going through a.
// if same(%4 'set' 'res')
rule peeph-1106
    for: v2 in ix | iy
    for: v3 in 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7
    for: v4 in set | res
    for: k1 in s8
    if: v4 == 'set' || v4 == 'res'  // same(%4 'set' 'res')
    before:
        ld	a, k1 (v2)
        v4	v3, a
        ld	k1 (v2), a
    after:
        v4	v3, k1 (v2)
        ld	a, k1 (v2)
    dead: below SP

// peeph.def:1116: common peephole 77a incremented immediate.
// if operandsLiteral(%3), immdInRange(0 256 '+' %3 1 %4), notUsed('f')
rule peeph-1116
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2, k3, k4 in u16; o1 in s8; x0, x1 in -32768..65535
    if: 0 <= (k3 + 1) && (k3 + 1) <= 256 && k4 == (k3 + 1)  // immdInRange(0 256 '+' %3 1 %4)
    if: x0 == k2 + k3
    if: x1 == k2 + k4
    before:
        ld	v1, #x0
        inc	v1
    after:
        ld	v1, #x1
    dead: CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:1124: common peephole 77b incremented immediate.
// if operandsLiteral(%3), immdInRange(0 256 '-' %3 1 %4), notUsed('f')
rule peeph-1124
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2, k3, k4 in u16; o1 in s8; x0, x1 in -32768..65535
    if: 0 <= (k3 - 1) && (k3 - 1) <= 256 && k4 == (k3 - 1)  // immdInRange(0 256 '-' %3 1 %4)
    if: x0 == k2 - k3
    if: x1 == k2 - k4
    before:
        ld	v1, #x0
        inc	v1
    after:
        ld	v1, #x1
    dead: CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:1132: common peephole 77c decremented immediate.
// if operandsLiteral(%3), immdInRange(0 256 '-' %3 1 %4), notUsed('f')
rule peeph-1132
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2, k3, k4 in u16; o1 in s8; x0, x1 in -32768..65535
    if: 0 <= (k3 - 1) && (k3 - 1) <= 256 && k4 == (k3 - 1)  // immdInRange(0 256 '-' %3 1 %4)
    if: x0 == k2 + k3
    if: x1 == k2 + k4
    before:
        ld	v1, #x0
        dec	v1
    after:
        ld	v1, #x1
    dead: CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:1140: common peephole 77d decremented immediate.
// if operandsLiteral(%3), immdInRange(0 256 '+' %3 1 %4), notUsed('f')
rule peeph-1140
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2, k3, k4 in u16; o1 in s8; x0, x1 in -32768..65535
    if: 0 <= (k3 + 1) && (k3 + 1) <= 256 && k4 == (k3 + 1)  // immdInRange(0 256 '+' %3 1 %4)
    if: x0 == k2 - k3
    if: x1 == k2 - k4
    before:
        ld	v1, #x0
        dec	v1
    after:
        ld	v1, #x1
    dead: CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:1148: common peephole 77e changed -0 to +0.
rule peeph-1148
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2 in u16; o1 in s8
    before:
        ld	v1, #k2 - 0
    after:
        ld	v1, #k2 + 0
    dead: below SP

// peeph.def:1155: common peephole 77f decremented immediate.
// if notUsed('f')
rule peeph-1155
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2 in u16; o1 in s8
    before:

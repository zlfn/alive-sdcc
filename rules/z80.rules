// peeph.def:1399: common peephole 94c reused constant #0 loaded into register.
// if same(%1 'inc' 'dec'), operandsLiteral(%2), immdInRange(0 0 '+' %2 0 %3)
rule peeph-1399
    for: v1 in inc | dec

// peeph.def:1920: common peephole 117 decremented in %2 (%3) instead of going through %1.
// if canAssign('a' %1)
rule peeph-1920
    for: v1 in a | b | c | d | e | h | l | (hl) | (de) | (bc) | #k1 | (k1)

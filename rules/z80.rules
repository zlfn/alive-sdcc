    if: v1 == a || v1 == b || v1 == c || v1 == d || v1 == e || v1 == h || v1 == l  // same(%1 'a' 'b' 'c' 'd' 'e' 'h' 'l')
    if: 0 <= (k2 + 0) && (k2 + 0) <= 0  // immdInRange(0 0 '+' %2 0 %3)

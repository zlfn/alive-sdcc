        ld	(hl), v1
    after:
        inc	(hl)
    dead: v1

// peeph.def:1888: common peephole 115a used (hl) in %3 instead of going through %1.
// if notVolatile(%2), notUsed(%1), notSame(%1 'a'), same(%3 'adc' 'and' 'add' 'cp' 'or' 'sbc' 'sub' 'xor')
rule peeph-1888
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in adc | and | add | cp | or | sbc | sub | xor
    for: k1, k2 in u16; o1, o2 in s8
    if: v1 != a  // notSame(%1 'a')
    if: v3 == 'adc' || v3 == 'and' || v3 == 'add' || v3 == 'cp' || v3 == 'or' || v3 == 'sbc' || v3 == 'sub' || v3 == 'xor'  // same(%3 'adc' 'and' 'add' 'cp' 'or' 'sbc' 'sub' 'xor')
    if: a != v2  // not ld x, x
    before:
        ld	v1, (hl)
        ld	a, v2
        v3	a, v1
    after:
        ld	a, v2
        v3	a, (hl)
    dead: v1

// peeph.def:1898: common peephole 115b used (hl) in subtraction instead of going through %1.
// if notUsed(%1), same(%3 'and' 'add' 'cp' 'or' 'sub' 'xor')
rule peeph-1898
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in and | add | cp | or | sub | xor
    for: k1 in u16; o1 in s8
    if: v3 == 'and' || v3 == 'add' || v3 == 'cp' || v3 == 'or' || v3 == 'sub' || v3 == 'xor'  // same(%3 'and' 'add' 'cp' 'or' 'sub' 'xor')
    before:
        ld	v1, (hl)
        xor	a, a
        v3	a, v1
    after:
        xor	a, a
        v3	a, (hl)
    dead: v1

// peeph.def:1909: common peephole 116 incremented in %2 (%3) instead of going through %1.
// if canAssign('a' %1)
rule peeph-1909
    for: v1 in a | b | c | d | e | h | l | (hl) | (de) | (bc) | #k1 | (k1)

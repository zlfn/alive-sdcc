// peeph.def:2803: common peephole 173 eliminated assignment by pushing %6
// if canJoinRegs(%2 %1 %7), same(%7 %5), canJoinRegs(%4 %3 %6), notUsed(%5)
rule peeph-2803
    for: v1 in c | e | l
    for: v2 in b | d | h
    for: v3 in c | e | l
    for: v4 in b | d | h
    for: v5 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k5 | (k5) | o5 (ix) | o5 (iy)
    for: v6 in bc | de | hl
    for: v7 in bc | de | hl
    for: k5 in u16; o5 in s8
    if: (v2 == b && v1 == c && v7 == bc) || (v2 == d && v1 == e && v7 == de) || (v2 == h && v1 == l && v7 == hl)  // canJoinRegs(%2 %1 %7)
    if: v7 == v5  // same(%7 %5)
    if: (v4 == b && v3 == c && v6 == bc) || (v4 == d && v3 == e && v6 == de) || (v4 == h && v3 == l && v6 == hl)  // canJoinRegs(%4 %3 %6)
    if: v1 != v3  // not ld x, x
    if: v2 != v4  // not ld x, x
    before:
        ld	v1, v3
        ld	v2, v4
        push	v5
    after:
        push	v6
    dead: v5

// peeph.def:2813: common peephole 174a reused value still in %1.
// if notSame(%1 'ix' 'iy'), notSame(%2 'ix' 'iy'), canSplitReg(%1 %5 %6), canSplitReg(%2 %7 %8), operandsLiteral(%3 %4), immdInRange(0 0 '-' %3 %4 %9)
rule peeph-2813
    for: v1 in bc | de | hl
    for: v2 in bc | de | hl
    for: v5 in b | d | h
    for: v6 in c | e | l
    for: v7 in b | d | h
    for: v8 in c | e | l
    for: k3, k4 in u16
    if: v1 != ix && v1 != iy  // notSame(%1 'ix' 'iy')
    if: v2 != ix && v2 != iy  // notSame(%2 'ix' 'iy')
    if: (v1 == bc && v5 == b && v6 == c) || (v1 == de && v5 == d && v6 == e) || (v1 == hl && v5 == h && v6 == l)  // canSplitReg(%1 %5 %6)
    if: (v2 == bc && v7 == b && v8 == c) || (v2 == de && v7 == d && v8 == e) || (v2 == hl && v7 == h && v8 == l)  // canSplitReg(%2 %7 %8)
    if: 0 <= (k3 - k4) && (k3 - k4) <= 0  // immdInRange(0 0 '-' %3 %4 %9)
    before:
        ld	v1, #k3
        ld	v2, #k4
    after:
        ld	v1, #k3
        ld	v7, v5
        ld	v8, v6
    dead: below SP

// peeph.def:2824: common peephole 174b reused value still in %1.
// if notSame(%1 'hl'), notSame(%2 'hl'), canSplitReg(%1 %5 %6), canSplitReg(%2 %7 %8), operandsLiteral(%3 %4), immdInRange(0 0 '-' %3 %4 %9), notSame(%1 'ix' 'iy'), notSame(%2 'ix' 'iy')
rule peeph-2824
    for: v1 in bc | de | hl
    for: v2 in bc | de | hl
    for: v5 in b | d | h
    for: v6 in c | e | l
    for: v7 in b | d | h
    for: v8 in c | e | l
    for: k3, k4 in u16
    if: v1 != hl  // notSame(%1 'hl')
    if: v2 != hl  // notSame(%2 'hl')
    if: (v1 == bc && v5 == b && v6 == c) || (v1 == de && v5 == d && v6 == e) || (v1 == hl && v5 == h && v6 == l)  // canSplitReg(%1 %5 %6)
    if: (v2 == bc && v7 == b && v8 == c) || (v2 == de && v7 == d && v8 == e) || (v2 == hl && v7 == h && v8 == l)  // canSplitReg(%2 %7 %8)
    if: 0 <= (k3 - k4) && (k3 - k4) <= 0  // immdInRange(0 0 '-' %3 %4 %9)
    if: v1 != ix && v1 != iy  // notSame(%1 'ix' 'iy')
    if: v2 != ix && v2 != iy  // notSame(%2 'ix' 'iy')
    before:
        ld	v1, #k3
        ld	v2, #k4
    after:
        ld	v1, #k3
        ld	v7, v5
        ld	v8, v6
    dead: below SP

// peeph.def:2834: common peephole 174c reused value still in %1.
rule peeph-2834
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; k2, k3, o1 in s8
    before:
        ld	v1, k2 (ix)
        ld	k3 (ix), v1
        ld	v1, k2 (ix)
    after:
        ld	v1, k2 (ix)
        ld	k3 (ix), v1
    dead: below SP

// peeph.def:2844: common peephole 176a remove unnecessary load back
// if notVolatile(%1), notVolatile(%2), notSame(%1 '(hl+)' '(hl-)'), notSame(%2 '(hl+)' '(hl-)')
rule peeph-2844
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k1, k2 in u16; o1, o2 in s8
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v2 != '(hl+)' && v2 != '(hl-)'  // notSame(%2 '(hl+)' '(hl-)')
    if: v1 != v2  // not ld x, x
    if: v2 != v1  // not ld x, x
    before:
        ld	v1, v2
        ld	v2, v1
    after:
        ld	v1, v2
    dead: below SP

// peeph.def:2853: common peephole 176b remove unnecessary load back
// if canSplitReg(%1 %0 %0)
rule peeph-2853
    for: v1 in bc | de | hl
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k2 in u16; o2 in s8
    before:
        ld	(v1), a
        inc	v1
        ld	(v1), v2
        ld	a, (v1)
        dec	v1
        or	a, (v1)
    after:
        ld	(v1), a
        inc	v1
        ld	(v1), v2
        or	a, v2
        dec	v1
    dead: below SP

// peeph.def:2869: common peephole 177b bubbled down push
rule peeph-2869
    for: v1 in c | bc | de | hl | sp | ix | iy
    for: k2 in u16
    before:
        push	v1
        ld	(v1), #k2
    after:
        ld	(v1), #k2
        push	v1
    dead: below SP

// peeph.def:2878: common peephole 177c bubbled down push
rule peeph-2878
    for: v1 in c | bc | de | hl | sp | ix | iy
    for: k2 in u16
    before:
        push	v1
        ld	a, #k2
        ld	(v1), a
    after:
        ld	a, #k2
        ld	(v1), a
        push	v1
    dead: below SP

// peeph.def:2889: common peephole 178 moved increment of %3 after ld instruction
// if operandsNotRelated(%1 %3), immdInRange(-128 127 '+' %2 1 %4)
rule peeph-2889
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in ix | iy
    for: k1 in u16; k2, k4, o1 in s8
    if: (v1 != ix && v1 != iy && v1 != 'o1 (ix)' && v1 != 'o1 (iy)') || ((v1 == ix || v1 == 'o1 (ix)') && v3 == iy) || ((v1 == iy || v1 == 'o1 (iy)') && v3 == ix)  // operandsNotRelated(%1 %3)
    if: -128 <= (k2 + 1) && (k2 + 1) <= 127 && k4 == (k2 + 1)  // immdInRange(-128 127 '+' %2 1 %4)
    before:
        inc	v3
        ld	v1, k2 (v3)
    after:
        ld	v1, k4 (v3)
        inc	v3
    dead: below SP

// peeph.def:2898: common peephole 179 moved decrement of %3 after ld instruction
// if operandsNotRelated(%1 %3), immdInRange(-128 127 '-' %2 1 %4)
rule peeph-2898
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in ix | iy
    for: k1 in u16; k2, k4, o1 in s8
    if: (v1 != ix && v1 != iy && v1 != 'o1 (ix)' && v1 != 'o1 (iy)') || ((v1 == ix || v1 == 'o1 (ix)') && v3 == iy) || ((v1 == iy || v1 == 'o1 (iy)') && v3 == ix)  // operandsNotRelated(%1 %3)
    if: -128 <= (k2 - 1) && (k2 - 1) <= 127 && k4 == (k2 - 1)  // immdInRange(-128 127 '-' %2 1 %4)
    before:
        dec	v3
        ld	v1, k2 (v3)
    after:
        ld	v1, k4 (v3)
        dec	v3
    dead: below SP

// peeph.def:2909: common peephole 190: move pop instruction after register store
// if notSame(%1 %3 %4), operandsNotRelated(%1 %4)
rule peeph-2909
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in ix | iy
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k1, k4 in u16; k2, o1, o4 in s8
    if: v1 != v3 && v1 != v4 && v3 != v4  // notSame(%1 %3 %4)
    if: ((v1 == a || v1 == af) && (v4 != a && v4 != af)) || ((v1 == b || v1 == c || v1 == bc) && (v4 != b && v4 != c && v4 != bc && v4 != '(bc)')) || ((v1 == d || v1 == e || v1 == de) && (v4 != d && v4 != e && v4 != de && v4 != '(de)')) || ((v1 == h || v1 == l || v1 == hl) && (v4 != h && v4 != l && v4 != hl && v4 != '(hl)')) || (v1 == sp && v4 != sp) || (v1 == '(hl)' && (v4 != h && v4 != l && v4 != hl && v4 != '(hl)' && v4 != '(k4)')) || (v1 == '(de)' && (v4 != d && v4 != e && v4 != de && v4 != '(de)' && v4 != '(k4)')) || (v1 == '(bc)' && (v4 != b && v4 != c && v4 != bc && v4 != '(bc)' && v4 != '(k4)')) || (v1 == ix && (v4 != ix && v4 != 'o4 (ix)')) || (v1 == iy && (v4 != iy && v4 != 'o4 (iy)')) || (v1 == '#k1' && (v4 != '#k4' || (v4 == '#k4' && !(k4 == k1)))) || (v1 == '(k1)' && v4 != '(k4)') || (v1 == 'o1 (ix)' && (v4 != ix && v4 != '(k4)' && v4 != 'o4 (ix)')) || (v1 == 'o1 (iy)' && (v4 != iy && v4 != '(k4)' && v4 != 'o4 (iy)'))  // operandsNotRelated(%1 %4)
    before:
        inc	sp
        pop	v1
        ld	k2 (v3), v4
    after:
        inc	sp
        ld	k2 (v3), v4
        pop	v1
    dead: below SP

// peeph.def:2920: common peephole 191a: move register store before stack restore
// if notSame(%2 'sp')
rule peeph-2920
    for: v2 in ix | iy
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: k1, o3 in s8; k3 in u16
    if: v2 != sp  // notSame(%2 'sp')
    before:
        inc	sp
        ld	k1 (v2), v3
    after:
        ld	k1 (v2), v3
        inc	sp
    dead: below SP

// peeph.def:2929: common peephole 191b: move register to register copy before SP increment
// if same(%3 'l' 'h'), notSame(%2 'l' 'h'), notUsed('hl'), operandsNotRelated(%1 %2 %3), notSame('sp' %2 %3)
rule peeph-2929
    for: v1 in a | b | c | d | e | bc | de | sp | af | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | bc | de | sp | af | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in l | h
    for: k1, k2 in u16; o1, o2 in s8
    if: v3 == l || v3 == h  // same(%3 'l' 'h')
    if: v2 != l && v2 != h  // notSame(%2 'l' 'h')
    if: ((v1 == a || v1 == af) && (v2 != a && v2 != af)) || ((v1 == b || v1 == c || v1 == bc) && (v2 != b && v2 != c && v2 != bc && v2 != '(bc)')) || ((v1 == d || v1 == e || v1 == de) && (v2 != d && v2 != e && v2 != de && v2 != '(de)')) || (v1 == sp && v2 != sp) || (v1 == '(de)' && (v2 != d && v2 != e && v2 != de && v2 != '(de)' && v2 != '(k2)')) || (v1 == '(bc)' && (v2 != b && v2 != c && v2 != bc && v2 != '(bc)' && v2 != '(k2)')) || (v1 == ix && (v2 != ix && v2 != 'o2 (ix)')) || (v1 == iy && (v2 != iy && v2 != 'o2 (iy)')) || (v1 == '#k1' && (v2 != '#k2' || (v2 == '#k2' && !(k2 == k1)))) || (v1 == '(k1)' && v2 != '(k2)') || (v1 == 'o1 (ix)' && (v2 != ix && v2 != '(k2)' && v2 != 'o2 (ix)')) || (v1 == 'o1 (iy)' && (v2 != iy && v2 != '(k2)' && v2 != 'o2 (iy)'))  // operandsNotRelated(%1 %2 %3)
    if: sp != v2 && sp != v3 && v2 != v3  // notSame('sp' %2 %3)
    if: v2 != v3  // not ld x, x
    before:
        inc	sp
        pop	v1
        ld	v2, v3
    after:
        ld	v2, v3
        inc	sp
        pop	v1
    dead: HL, below SP

// peeph.def:2940: common peephole 191c: move register store before stack restore
// if notUsed('hl'), same(%2 'h' 'l' 'sp'), notSame(%1 'h' 'l' 'sp')
rule peeph-2940
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in h | l | sp
    for: k1 in u16; o1 in s8
    if: v2 == h || v2 == l || v2 == sp  // same(%2 'h' 'l' 'sp')
    if: v1 != h && v1 != l && v1 != sp  // notSame(%1 'h' 'l' 'sp')
    if: v1 != v2  // not ld x, x
    before:
        inc	sp
        ld	v1, v2
    after:
        ld	v1, v2
        inc	sp
    dead: HL, below SP

// peeph.def:2949: common peephole 192: increase SP by addition
// if notUsed(%3), same(%3 'hl' 'ix' 'iy'), immdInRange(0 0x7fff '+' %1 1 %2)
rule peeph-2949
    for: v3 in hl | ix | iy
    for: k1, k2 in u16
    if: v3 == hl || v3 == ix || v3 == iy  // same(%3 'hl' 'ix' 'iy')
    if: 0 <= (k1 + 1) && (k1 + 1) <= 32767 && k2 == (k1 + 1)  // immdInRange(0 0x7fff '+' %1 1 %2)
    if: sp != v3  // not ld x, x
    before:
        inc	sp
        ld	v3, #k1
        add	v3, sp
        ld	sp, v3
    after:
        ld	v3, #k2
        add	v3, sp
        ld	sp, v3
    dead: v3, below SP

// peeph.def:2961: common peephole 193: increase SP by addition
// if notUsed('hl')
rule peeph-2961
    before:
        inc	sp
        inc	sp
        inc	sp
        inc	sp
        inc	sp
    after:
        ld	hl, #5
        add	hl, sp
        ld	sp, hl
    dead: HL, below SP

// peeph.def:2975: common peephole 194-1: symplify 32-bit compare for 8 bit values
// if same(%5 'jr' 'jp' 'call'), notUsed('a'), canAssign('b' %3), canAssign('b' %3), newLabel(%9)
rule peeph-2975
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | (hl) | #k3
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: v5 in jr | jp | call
    for: k1, k2, k3, k4, k7 in u16; o1, o2, o4 in s8
    if: v5 == 'jr' || v5 == 'jp' || v5 == 'call'  // same(%5 'jr' 'jp' 'call')
    if: a != v1  // not ld x, x
    if: a != v2  // not ld x, x
    if: a != v3  // not ld x, x
    if: a != v4  // not ld x, x
    before:
        ld	a, v1
        sub	a, #k7
        ld	a, v2
        sbc	a, #0x00
        ld	a, v3
        sbc	a, #0x00
        ld	a, v4
        sbc	a, #0x00
        v5	c, l6
    after:
        ld	a, v2
        or	a, v3
        or	a, v4
        jp	nz, l9
        ld	a, v1
        cp	a, #k7
        v5	c, l6
        l9:
    dead: A, below SP

// peeph.def:2997: common peephole 194-2: symplify 32-bit compare for 16 bit values
// if same(%5 'jr' 'jp' 'call'), notUsed('a'), canAssign('b' %3), newLabel(%9)
rule peeph-2997
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | (hl) | #k3
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: v5 in jr | jp | call
    for: k1, k2, k3, k4, k7, k8 in u16; o1, o2, o4 in s8
    if: v5 == 'jr' || v5 == 'jp' || v5 == 'call'  // same(%5 'jr' 'jp' 'call')
    if: a != v1  // not ld x, x
    if: a != v2  // not ld x, x
    if: a != v3  // not ld x, x
    if: a != v4  // not ld x, x
    before:
        ld	a, v1
        sub	a, #k7
        ld	a, v2
        sbc	a, #k8
        ld	a, v3
        sbc	a, #0x00
        ld	a, v4
        sbc	a, #0x00
        v5	c, l6
    after:
        ld	a, v3
        or	a, v4
        jp	nz, l9
        ld	a, v1
        sub	a, #k7
        ld	a, v2
        sbc	a, #k8
        v5	c, l6
        l9:
    dead: A, below SP

// peeph.def:3020: common peephole 195-1: remove always true check
// if same(%2 'jr' 'jp' 'call'), notUsed('a'), labelRefCountChange(%3 -1)
rule peeph-3020
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in jr | jp | call
    for: k1 in u16; o1 in s8
    if: v2 == 'jr' || v2 == 'jp' || v2 == 'call'  // same(%2 'jr' 'jp' 'call')
    before:
        ld	a, #0xff
        cp	a, v1
        v2	nc, l3
    after:
    dead: A, below SP

// peeph.def:3028: common peephole 195-2: remove always true check
// if same(%3 'jr' 'jp' 'call'), notUsed('a'), labelRefCountChange(%4 -1)
rule peeph-3028
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in jr | jp | call
    for: k1, k2 in u16; o1, o2 in s8
    if: v3 == 'jr' || v3 == 'jp' || v3 == 'call'  // same(%3 'jr' 'jp' 'call')
    before:
        ld	a, #0xff
        sub	a, v1
        ld	a, #0xff
        sbc	a, v2
        v3	nc, l4
    after:
    dead: A, below SP

// peeph.def:3041: common peephole 156 used ex to load hl into de.
// if isPort('z80' 'ez80' 'z180' 'z80n' 'r2k' 'r2ka' 'r3ka' 'r4k' 'r5k' 'r6k' 'tlcs90'), notUsed('hl')
rule peeph-3041
    before:
        ld	e, l
        ld	d, h
    after:
        ex	de, hl
    dead: HL, below SP

// peeph.def:3049: common peephole 157 used ex to load de into hl.
// if isPort('z80' 'ez80' 'z180' 'z80n' 'r2k' 'r2ka' 'r3ka' 'r4k' 'r5k' 'r6k' 'tlcs90'), notUsed('de')
rule peeph-3049
    before:
        ld	l, e
        ld	h, d
    after:
        ex	de, hl
    dead: DE, below SP

// peeph.def:3068: common peephole 157b merged offset into storage instruction.
// if notSame(%1 %3 %2), notUsed(%1), immdInRange(0 127 '+' %2 1 %4)
rule peeph-3068
    for: v1 in ix | iy
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: k2, k4, o3 in s8; k3 in u16
    if: v1 != v3 && v1 != k2 && v3 != k2  // notSame(%1 %3 %2)
    if: 0 <= (k2 + 1) && (k2 + 1) <= 127 && k4 == (k2 + 1)  // immdInRange(0 127 '+' %2 1 %4)
    before:
        inc	v1
        ld	k2 (v1), v3
    after:
        ld	k4 (v1), v3
    dead: v1, below SP

// peeph.def:3087: common peephole 157d reused 0 in a.
rule peeph-3087
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k2 in u16; o2 in s8
    before:
        xor	a, a
        sbc	hl, v2
        ld	a, #0x01
        jp	z, l5
        xor	a, a
        l5:
    after:
        xor	a, a
        sbc	hl, v2
        jp	nz, l5
        inc	a
        l5:
    dead: below SP

// peeph.def:3107: common peephole 158 removed redundant ld %1, %1.
// if notVolatile(%1)
rule peeph-3107
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        ld	v1, v1
    after:
    dead: below SP

// peeph.def:3117: common peephole 159 removed unused label %1.
// if labelRefCount(%1 0)
rule peeph-3117
    before:
        l1:
    after:
    dead: below SP

// peeph.def:3127: common peephole 160 replaced jump by return.
// if labelIsReturnOnly(%5), labelRefCountChange(%5 -1)
rule peeph-3127
    before:
        jp	l5
        halt
        l5:
        ret
    after:
        ret
        halt
        l5:
        ret
    dead: below SP

// peeph.def:3145: common peephole 161 replaced jump by return.
// if isPort('z80' 'z80n' 'z180' 'sm83' 'tlcs90' 'ez80' 'r800'), labelIsReturnOnly(%5), labelRefCountChange(%5 -1)
rule peeph-3145
    for: v1 in z | nz | c | nc | po | pe | p | m
    before:
        jp	v1, l5
        halt
        l5:
        ret
    after:
        ret	v1
        halt
        l5:
        ret
    dead: below SP

// peeph.def:3156: common peephole 162 changed absolute to relative unconditional jump.
// if optimizeFor('!code-speed'), labelInRange(%5)
rule peeph-3156
    before:
        jp	l5
    after:
        jr	l5
    dead: below SP

// peeph.def:3171: common peephole 163 changed absolute to relative conditional jump.
// if same(%1 'c' 'nc' 'nz' 'z'), labelInRange(%5)
rule peeph-3171
    for: v1 in c | nc | nz | z
    if: v1 == c || v1 == nc || v1 == nz || v1 == z  // same(%1 'c' 'nc' 'nz' 'z')
    before:
        jp	v1, l5
    after:
        jr	v1, l5
    dead: below SP

// peeph.def:3178: common peephole 164 eliminated relative conditional jump.
// if labelRefCountChange(%5 -1)
rule peeph-3178
    for: v1 in z | nz | c | nc | po | pe | p | m
    before:
        jr	v1, l5
        l5:
    after:
        l5:
    dead: below SP

// peeph.def:3186: common peephole 167 used djnz
// if isPort('z80' 'ez80' 'z180' 'z80n' 'r2k' 'r2ka' 'r3ka' 'r4k' 'r5k' 'r6k' 'tlcs90')
rule peeph-3186
    before:
        dec	b
        jr	nz, l5
    after:
        djnz	l5
    dead: below SP

// peeph-z80.def:22: peephole 178 direct load zero constant to memory addressed by index register
// if notUsed('a'), canAssign(%1 %2 '#0')
rule peeph-z80-22
    for: v2 in ix | iy
    for: k1 in s8
    before:
        xor	a, a
        ld	k1 (v2), a
    after:
        ld	k1 (v2), #0
    dead: A, below SP

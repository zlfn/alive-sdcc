    for: v1 in a | b | c | d | e | bc | de | sp | af | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy) | 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7
    for: v2 in a | b | c | d | e | bc | de | sp | af | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in inc | dec
    for: v4 in ld | ldh | cp | add | adc | and | or | xor | sub | sbc | set | res | bit | in | out | in0 | out0
    for: v5 in hl
    for: k1, k2 in u16; o1, o2 in s8
    if: v3 == 'inc' || v3 == 'dec'  // same(%3 'inc' 'dec')
    if: v5 == hl  // same(%5 'hl')
    if: v4 == 'ld' || v4 == 'ldh' || v4 == 'cp' || v4 == 'add' || v4 == 'adc' || v4 == 'and' || v4 == 'or' || v4 == 'xor' || v4 == 'sub' || v4 == 'sbc' || v4 == 'set' || v4 == 'res' || v4 == 'bit' || v4 == 'in' || v4 == 'out' || v4 == 'in0' || v4 == 'out0'  // same(%4 'ld' 'ldh' 'cp' 'add' 'adc' 'and' 'or' 'xor' 'sub' 'sbc' 'set' 'res' 'bit' 'in' 'out' 'in0' 'out0')
    if: (v4 != 'set' && v4 != 'res' && v4 != 'bit') || (v1 == 0 || v1 == 1 || v1 == 2 || v1 == 3 || v1 == 4 || v1 == 5 || v1 == 6 || v1 == 7)  // a bit number
    before:

rule peeph-1517
    for: v1 in a | b | c | d | e | bc | de | sp | af | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in inc | dec | rl | rlc | rr | rrc | srl | sla | sra | swap
    for: v3 in inc | dec
    for: v4 in hl
    for: k1 in u16; o1 in s8
    if: v3 == 'inc' || v3 == 'dec'  // same(%3 'inc' 'dec')
    if: v4 == hl  // same(%4 'hl')
    if: v2 == 'inc' || v2 == 'dec' || v2 == 'rl' || v2 == 'rlc' || v2 == 'rr' || v2 == 'rrc' || v2 == 'srl' || v2 == 'sla' || v2 == 'sra' || v2 == 'swap'  // same(%2 'inc' 'dec' 'rl' 'rlc' 'rr' 'rrc' 'srl' 'sla' 'sra' 'swap')
    before:
        v2	v1
        v3	v4
    after:
        v3	v4
        v2	v1
    dead: below SP

// peeph.def:1526: common peephole 96d move %3 %4 before %2 %1
// if same(%3 'inc' 'dec'), same(%4 'hl'), same(%2 'push' 'pop'), notSame(%1 %4)
rule peeph-1526
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in push | pop
    for: v3 in inc | dec
    for: v4 in hl
    for: k1 in u16; o1 in s8
    if: v3 == 'inc' || v3 == 'dec'  // same(%3 'inc' 'dec')
    if: v4 == hl  // same(%4 'hl')
    if: v2 == 'push' || v2 == 'pop'  // same(%2 'push' 'pop')
    if: v1 != v4  // notSame(%1 %4)
    before:
        v2	v1
        v3	v4
    after:
        v3	v4
        v2	v1
    dead: below SP

// peeph.def:1536: common peephole 97a reused constant loaded into register pair. %2 %3
// if same(%1 'bc' 'de'), operandsLiteral(%2 %3), canSplitReg(%1 %4 %5), immdInRange(0x00 0xff '&' %3 0xff %7), immdInRange(0 0 '-' %7 %2 %8)
rule peeph-1536
    for: v1 in bc | de
    for: v5 in c | e
    for: k2, k3 in u16; k7 in 0..255
    if: v1 == bc || v1 == de  // same(%1 'bc' 'de')
    if: (v1 == bc && v5 == c) || (v1 == de && v5 == e)  // canSplitReg(%1 %4 %5)
    if: 0 <= (k3 & 255) && (k3 & 255) <= 255 && k7 == (k3 & 255)  // immdInRange(0x00 0xff '&' %3 0xff %7)
    if: 0 <= (k7 - k2) && (k7 - k2) <= 0  // immdInRange(0 0 '-' %7 %2 %8)
    before:
        ld	(hl), #k2
        ld	v1, #k3
    after:
        ld	v1, #k3
        ld	(hl), v5
    dead: below SP

// peeph.def:1547: common peephole 97b reused constant loaded into register pair.
// if same(%1 'bc' 'de'), operandsLiteral(%2 %3), canSplitReg(%1 %4 %5), immdInRange(0x00 0xff '/' %3 0xff %6), immdInRange(0x00 0xff '&' %6 0xff %7), immdInRange(0 0 '-' %7 %2 %8)
rule peeph-1547
    for: v1 in bc | de
    for: v4 in b | d
    for: k2, k3 in u16; k6, k7 in 0..255
    if: v1 == bc || v1 == de  // same(%1 'bc' 'de')
    if: (v1 == bc && v4 == b) || (v1 == de && v4 == d)  // canSplitReg(%1 %4 %5)
    if: 0 <= (k3 / 255) && (k3 / 255) <= 255 && k6 == (k3 / 255)  // immdInRange(0x00 0xff '/' %3 0xff %6)
    if: 0 <= (k6 & 255) && (k6 & 255) <= 255 && k7 == (k6 & 255)  // immdInRange(0x00 0xff '&' %6 0xff %7)
    if: 0 <= (k7 - k2) && (k7 - k2) <= 0  // immdInRange(0 0 '-' %7 %2 %8)
    before:
        ld	(hl), #k2
        ld	v1, #k3
    after:
        ld	v1, #k3
        ld	(hl), v4
    dead: below SP

// peeph.def:1557: common peephole 98 removed redundant load from %1 into a.
// if notVolatile(%1), notSame(%1 '(hl+)' '(hl-)')
rule peeph-1557
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v1 != a  // not ld x, x
    if: a != v1  // not ld x, x
    before:
        ld	v1, a
        ld	a, v1
    after:
        ld	v1, a
    dead: below SP

// peeph.def:1567: common peephole 98a removed redundant load of %1 from %2 (ix)
rule peeph-1567
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; k2, o1 in s8
    before:
        ld	k2 (ix), v1
        ld	v1, k2 (ix)
    after:
        ld	k2 (ix), v1
    dead: below SP

// peeph.def:1575: common peephole 98b removed redundant load of %1 from %2 (sp)
rule peeph-1575
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; k2, o1 in s8
    before:
        ld	k2 (sp), v1
        ld	v1, k2 (sp)
    after:
        ld	k2 (sp), v1
    dead: below SP

// peeph.def:1583: common peephole 99 removed load by reordering or arguments.
// if notVolatile(%1), canAssign('b' %2), notSame(%1 '(hl+)' '(hl-)')
rule peeph-1583
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | (hl) | #k2
    for: k1, k2 in u16; o1 in s8
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v1 != a  // not ld x, x
    if: a != v2  // not ld x, x
    before:
        ld	v1, a
        ld	a, v2
        or	a, v1
    after:
        ld	v1, a
        or	a, v2
    dead: below SP

// peeph.def:1594: common peephole 99a removed load by reordering or arguments.
// if notUsed(%1)
rule peeph-1594
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        ld	v1, (hl)
        inc	hl
        ld	a, (hl)
        or	a, v1
    after:
        ld	a, (hl)
        inc	hl
        or	a, (hl)
    dead: v1

// peeph.def:1606: common peephole 99b removed load by reordering.
rule peeph-1606
    for: v2 in ix | iy
    for: k1 in s8
    before:
        ld	k1 (v2), #0x00
        xor	a, a
    after:
        xor	a, a
        ld	k1 (v2), a
    dead: below SP

// peeph.def:1615: common peephole 99c removed redundant or argument.
rule peeph-1615
    before:
        or	a, #0x00
    after:
        or	a, a
    dead: below SP

// peeph.def:1622: common peephole 100 removed redundant or after and.
rule peeph-1622
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        and	a, v1
        or	a, a
    after:
        and	a, v1
    dead: below SP

// peeph.def:1630: common peephole 100a removed redundant or after and.
rule peeph-1630
    for: v2 in ix | iy
    for: k1 in s8
    before:
        and	a, k1 (v2)
        or	a, a
    after:
        and	a, k1 (v2)
    dead: below SP

// peeph.def:1638: common peephole 100b removed redundant or after %2
// if same(%2 'inc' 'dec'), notUsed('cf' 'hf' 'nf' 'sf' 'pf')
rule peeph-1638
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in inc | dec
    for: k1 in u16; o1 in s8
    if: v2 == 'inc' || v2 == 'dec'  // same(%2 'inc' 'dec')
    if: a != v1  // not ld x, x
    before:
        v2	v1
        ld	a, v1
        or	a, a
    after:
        v2	v1
        ld	a, v1
    dead: CF, HF, NF, PVF, SF, below SP

// peeph.def:1649: common peephole 101 removed redundant or after xor.
rule peeph-1649
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        xor	a, v1
        or	a, a
    after:
        xor	a, v1
    dead: below SP

// peeph.def:1657: common peephole 102 removed redundant or after xor.
rule peeph-1657
    for: v2 in ix | iy
    for: k1 in s8
    before:
        xor	a, k1 (v2)
        or	a, a
    after:
        xor	a, k1 (v2)
    dead: below SP

// peeph.def:1665: common peephole 102a removed redundant or after dec.
// if notUsed('cf')
rule peeph-1665
    before:
        dec	a
        or	a, a
    after:
        dec	a
    dead: CF, below SP

// peeph.def:1673: common peephole 102b removed redundant or after dec.
// if notUsed('cf')
rule peeph-1673
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: a != v1  // not ld x, x
    before:
        dec	v1
        ld	a, v1
        or	a, a
    after:
        dec	v1
        ld	a, v1
    dead: CF, below SP

// peeph.def:1684: common peephole 102c removed redundant or after sbc.
// if same(%2 'nz' 'z'), notUsed('a'), notUsedFrom(%3 'a')
rule peeph-1684
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in nz | z
    for: k1 in u16; o1 in s8
    if: v2 == nz || v2 == z  // same(%2 'nz' 'z')
    before:
        sbc	hl, v1
        ld	a, h
        or	a, l
        jp	v2, l3
    after:
        sbc	hl, v1
        jp	v2, l3
    dead: A, below SP

// peeph.def:1695: common peephole 102d removed redundant or after sub.
// if same(%3 'nz' 'z')
rule peeph-1695
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in nz | z
    for: k1, k2 in u16; o1, o2 in s8
    if: v3 == nz || v3 == z  // same(%3 'nz' 'z')
    if: v2 != a  // not ld x, x
    before:
        sub	a, v1
        ld	v2, a
        or	a, a
        jp	v3, l4
    after:
        sub	a, v1
        ld	v2, a
        jp	v3, l4
    dead: below SP

// peeph.def:1707: common peephole 103 loaded value in a first and used it next
// if notVolatile(%1 %2), canAssign(%1 'a'), operandsNotRelated(%1 %2), notSame(%1 '(hl+)' '(hl-)'), notSame(%2 '(hl+)' '(hl-)')
rule peeph-1707
    for: v1 in a | b | c | d | e | h | l | (hl) | (de) | (bc) | (k1)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k1, k2 in u16; o2 in s8
    if: (v1 == a && (v2 != a && v2 != af)) || ((v1 == b || v1 == c) && (v2 != b && v2 != c && v2 != bc && v2 != '(bc)')) || ((v1 == d || v1 == e) && (v2 != d && v2 != e && v2 != de && v2 != '(de)')) || ((v1 == h || v1 == l) && (v2 != h && v2 != l && v2 != hl && v2 != '(hl)')) || (v1 == '(hl)' && (v2 != h && v2 != l && v2 != hl && v2 != '(hl)' && v2 != '(k2)')) || (v1 == '(de)' && (v2 != d && v2 != e && v2 != de && v2 != '(de)' && v2 != '(k2)')) || (v1 == '(bc)' && (v2 != b && v2 != c && v2 != bc && v2 != '(bc)' && v2 != '(k2)')) || (v1 == '(k1)' && v2 != '(k2)')  // operandsNotRelated(%1 %2)
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v2 != '(hl+)' && v2 != '(hl-)'  // notSame(%2 '(hl+)' '(hl-)')
    if: v1 != v2  // not ld x, x
    if: a != v2  // not ld x, x
    before:
        ld	v1, v2
        ld	a, v2
    after:
        ld	a, v2
        ld	v1, a
    dead: below SP

// peeph.def:1717: common peephole 103b loaded constant in %2 first and used it next
// if notVolatile(%2), canAssign(%3 %2), same(%2 'a' 'b' 'c' 'd' 'e' 'h' 'l')
rule peeph-1717
    for: v2 in a | b | c | d | e | h | l
    for: v3 in a | b | c | d | e | h | l | (hl) | (de) | (bc) | (k3)
    for: k1, k3 in u16
    if: (v3 != '(de)' && v3 != '(bc)' && v3 != '(k3)') || ((v3 == '(de)' || v3 == '(bc)' || v3 == '(k3)') && v2 == a)  // canAssign(%3 %2)
    if: v2 == a || v2 == b || v2 == c || v2 == d || v2 == e || v2 == h || v2 == l  // same(%2 'a' 'b' 'c' 'd' 'e' 'h' 'l')
    before:
        ld	v2, #k1
        ld	v3, #k1
    after:
        ld	v2, #k1
        ld	v3, v2
    dead: below SP

// peeph.def:1726: common peephole 104 removed redundant load from %3%1 into %4%2
// if notVolatile(%1 %2 %3 %4), notSame(%1 '(hl+)' '(hl-)'), notSame(%2 '(hl+)' '(hl-)'), notSame(%3 '(hl+)' '(hl-)'), notSame(%4 '(hl+)' '(hl-)')
rule peeph-1726
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k1, k2, k3, k4 in u16; o1, o2, o3, o4 in s8
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v2 != '(hl+)' && v2 != '(hl-)'  // notSame(%2 '(hl+)' '(hl-)')
    if: v3 != '(hl+)' && v3 != '(hl-)'  // notSame(%3 '(hl+)' '(hl-)')
    if: v4 != '(hl+)' && v4 != '(hl-)'  // notSame(%4 '(hl+)' '(hl-)')
    if: v1 != v2  // not ld x, x
    if: v3 != v4  // not ld x, x
    if: v2 != v1  // not ld x, x
    if: v4 != v3  // not ld x, x
    before:
        ld	v1, v2
        ld	v3, v4
        ld	v2, v1
        ld	v4, v3
    after:
        ld	v1, v2
        ld	v3, v4
    dead: below SP

// peeph.def:1737: common peephole 104b %3 %1 directly to remove redundant load from %2 into %1
// if same(%1 'a' 'b' 'c' 'd' 'e' 'h' 'l' '(hl)'), same(%3 'inc' 'dec')
rule peeph-1737
    for: v1 in a | b | c | d | e | h | l | (hl)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in inc | dec
    for: k2 in u16; o2 in s8
    if: v1 == a || v1 == b || v1 == c || v1 == d || v1 == e || v1 == h || v1 == l || v1 == '(hl)'  // same(%1 'a' 'b' 'c' 'd' 'e' 'h' 'l' '(hl)')
    if: v3 == 'inc' || v3 == 'dec'  // same(%3 'inc' 'dec')
    if: v2 != v1  // not ld x, x
    if: v1 != v2  // not ld x, x
    before:
        ld	v2, v1
        v3	v2
        ld	v1, v2
    after:
        v3	v1
        ld	v2, v1
    dead: below SP

// peeph.def:1747: common peephole 105 pushed de
// if notUsed('a')
rule peeph-1747
    before:
        push	de
        inc	sp
        ld	a, e
        push	af
        inc	sp
    after:
        push	de
    dead: A, below SP

// peeph.def:1758: common peephole 106 fixed stack using hl instead of iy.
// if notUsed('hl'), notUsed('iy')
rule peeph-1758
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: iy != v1  // not ld x, x
    before:
        ld	iy, v1
        add	iy, sp
        ld	sp, iy
    after:
        ld	hl, v1
        add	hl, sp
        ld	sp, hl
    dead: HL, IY, below SP

// peeph.def:1799: common peephole 109 replaced zero load, rla by and since rlca writes the same value to carry bit and least significant bit.
rule peeph-1799
    before:
        rlca
        ld	a, #0x00
        rla
    after:
        rlca
        and	a, #0x01
    dead: below SP

// peeph.def:1809: common peephole 110 moved %2 directly into de instead of going through %1.
rule peeph-1809
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k1, k2, k3, k4 in u16; o1, o2, o3, o4 in s8
    if: v1 != v2  // not ld x, x
    if: v1 != v3  // not ld x, x
    before:
        ld	v1, v2
        push	v1
        pop	v4
        ld	v1, v3
    after:
        ld	v4, v2
        ld	v1, v3
    dead: below SP

// peeph.def:1820: common peephole 111 removed lower part of multibyte addition.
rule peeph-1820
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k2, k3, k4 in u16; o2, o3, o4 in s8
    if: v2 != a  // not ld x, x
    if: a != v3  // not ld x, x
    before:
        add	a, #0x00
        ld	v2, a
        ld	a, v3
        adc	a, v4
    after:
        ld	v2, a
        ld	a, v3
        add	a, v4
    dead: below SP

// peeph.def:1832: common peephole 112 used 16-bit addition.
// if operandsLiteral(%1 %2), immdInRange(0x00 0xffff '*' %2 0x100 %3), immdInRange(0x00 0xffff '|' %3 %1 %x4), notUsed('hl')
rule peeph-1832
    for: k1, k2, k4 in u16; k3 in 0..65535
    if: 0 <= (k2 * 256) && (k2 * 256) <= 65535 && k3 == (k2 * 256)  // immdInRange(0x00 0xffff '*' %2 0x100 %3)
    if: 0 <= (k3 | k1) && (k3 | k1) <= 65535 && k4 == (k3 | k1)  // immdInRange(0x00 0xffff '|' %3 %1 %x4)
    before:
        ld	a, l
        add	a, #k1
        ld	e, a
        ld	a, h
        adc	a, #k2
        ld	d, a
    after:
        ld	de, #k4
        add	hl, de
        ld	e, l
        ld	d, h
        ld	a, h
    dead: HL, below SP

// peeph.def:1848: common peephole 113 used 16-bit addition.
// if operandsLiteral(%1 %2), immdInRange(0x00 0xffff '*' %2 0x100 %3), immdInRange(0x00 0xffff '|' %3 %1 %x4), notUsed('hl')
rule peeph-1848
    for: k1, k2, k4 in u16; k3 in 0..65535
    if: 0 <= (k2 * 256) && (k2 * 256) <= 65535 && k3 == (k2 * 256)  // immdInRange(0x00 0xffff '*' %2 0x100 %3)
    if: 0 <= (k3 | k1) && (k3 | k1) <= 65535 && k4 == (k3 | k1)  // immdInRange(0x00 0xffff '|' %3 %1 %x4)
    before:
        ld	a, l
        add	a, #k1
        ld	c, a
        ld	a, h
        adc	a, #k2
        ld	b, a
    after:
        ld	bc, #k4
        add	hl, bc
        ld	c, l
        ld	b, h
        ld	a, h
    dead: HL, below SP

// peeph.def:1864: common peephole 114 incremented in (hl) instead of going through a.
// if notUsed('a')
rule peeph-1864
    for: k1, k2 in s8
    before:
        ld	l, k1 (ix)
        ld	h, k2 (ix)
        ld	a, (hl)
        inc	a
        ld	l, k1 (ix)
        ld	h, k2 (ix)
        ld	(hl), a
    after:
        ld	l, k1 (ix)
        ld	h, k2 (ix)
        inc	(hl)
    dead: A, below SP

// peeph.def:1879: common peephole 115 incremented in (hl) instead of going through %1.
// if notUsed(%1)
rule peeph-1879
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)

// peeph.def:1930: common peephole 118 removed load by exploiting commutativity of addition.
// if notSame(%2 '(bc)' '(de)'), canAssign('b' %2)
rule peeph-1930
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | (hl) | #k2
    for: k1, k2 in u16; o1 in s8
    if: v2 != '(bc)' && v2 != '(de)'  // notSame(%2 '(bc)' '(de)')
    if: v1 != a  // not ld x, x
    if: a != v2  // not ld x, x
    before:
        ld	v1, a
        ld	a, v2
        add	a, v1
    after:
        ld	v1, a
        add	a, v2
    dead: below SP

// peeph.def:1941: common peephole 119 removed loads by exploiting commutativity of addition.
// if notUsed('bc')
rule peeph-1941

// peeph.def:1307: common peephole 92a combined constant loads into register pair.
// if canJoinRegs(%6 %5 %7), operandsLiteral(%1 %2), immdInRange(0x00 0xffff '*' %2 0x100 %3), immdInRange(0x00 0xffff '|' %3 %1 %x4)
rule peeph-1307
    for: v5 in c | e | l
    for: v6 in b | d | h
    for: v7 in bc | de | hl
    for: k1, k2, k4 in u16; k3 in 0..65535
    if: (v6 == b && v5 == c && v7 == bc) || (v6 == d && v5 == e && v7 == de) || (v6 == h && v5 == l && v7 == hl)  // canJoinRegs(%6 %5 %7)
    if: 0 <= (k2 * 256) && (k2 * 256) <= 65535 && k3 == (k2 * 256)  // immdInRange(0x00 0xffff '*' %2 0x100 %3)
    if: 0 <= (k3 | k1) && (k3 | k1) <= 65535 && k4 == (k3 | k1)  // immdInRange(0x00 0xffff '|' %3 %1 %x4)
    before:
        ld	v5, #k1
        ld	v6, #k2
    after:
        ld	v7, #k4
    dead: below SP


// peeph.def:1499: common peephole 96a move %2 %3 before %1
// if same(%2 'inc' 'dec'), same(%3 'hl'), same(%1 'rlca' 'rrca' 'rra' 'rla' 'cpl' 'scf' 'daa' 'ccf' 'sra' 'swap' 'nop')
rule peeph-1499
    for: v1 in rlca | rrca | rra | rla | cpl | scf | daa | ccf | sra | swap | nop
    for: v2 in inc | dec
    for: v3 in hl
    if: v2 == 'inc' || v2 == 'dec'  // same(%2 'inc' 'dec')
    if: v3 == hl  // same(%3 'hl')
    if: v1 == 'rlca' || v1 == 'rrca' || v1 == 'rra' || v1 == 'rla' || v1 == 'cpl' || v1 == 'scf' || v1 == 'daa' || v1 == 'ccf' || v1 == 'sra' || v1 == 'swap' || v1 == 'nop'  // same(%1 'rlca' 'rrca' 'rra' 'rla' 'cpl' 'scf' 'daa' 'ccf' 'sra' 'swap' 'nop')
    before:
        v1
        v2	v3
    after:
        v2	v3
        v1
    dead: below SP

// peeph.def:1508: common peephole 96b move %3 %5 before %4 %1, %2
// if same(%3 'inc' 'dec'), same(%5 'hl'), same(%4 'ld' 'ldh' 'cp' 'add' 'adc' 'and' 'or' 'xor' 'sub' 'sbc' 'set' 'res' 'bit' 'in' 'out' 'in0' 'out0'), operandsNotRelated(%1 %5), operandsNotRelated(%2 %5)

        ld	v4, a
    dead: below SP

// peeph.def:2168: common peephole 129a moved increment of hl to constant.
// if operandsLiteral(%1), immdInRange(0 0xFFFF '+' %1 1 %x3)
rule peeph-2168
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k1, k2, k3 in u16; o2 in s8
    if: 0 <= (k1 + 1) && (k1 + 1) <= 65535 && k3 == (k1 + 1)  // immdInRange(0 0xFFFF '+' %1 1 %x3)
    before:
        ld	hl, #k1
        add	hl, v2
        inc	hl
    after:
        ld	hl, #k3
        add	hl, v2
    dead: below SP

// peeph.def:2179: common peephole 129b moved decrement of hl to constant.
// if operandsLiteral(%1), immdInRange(0 0xFFFF '-' %1 1 %x3)
rule peeph-2179
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k1, k2, k3 in u16; o2 in s8
    if: 0 <= (k1 - 1) && (k1 - 1) <= 65535 && k3 == (k1 - 1)  // immdInRange(0 0xFFFF '-' %1 1 %x3)
    before:
        ld	hl, #k1
        add	hl, v2
        dec	hl
    after:
        ld	hl, #k3
        add	hl, v2
    dead: below SP

// peeph.def:2189: common peephole 129c moved increment of hl to constant.
rule peeph-2189
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k1, k2 in u16; o2 in s8
    before:
        ld	hl, #k1
        add	hl, v2
        inc	hl
    after:
        ld	hl, #k1 + 1
        add	hl, v2
    dead: below SP

// peeph.def:2199: common peephole 129d moved decrement of hl to constant.
rule peeph-2199
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k1, k2 in u16; o2 in s8
    before:
        ld	hl, #k1
        add	hl, v2
        dec	hl
    after:
        ld	hl, #k1 - 1
        add	hl, v2
    dead: below SP

// peeph.def:2209: common peephole 130a removed unnecessary +0 from constant
rule peeph-2209
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2 in u16; o1 in s8
    before:
        ld	v1, #k2 + 0
    after:
        ld	v1, #k2
    dead: below SP

// peeph.def:2217: common peephole 130b added +%3 to immediate %2
// if operandsLiteral(%2 %3), immdInRange(0 0xFF '+' %2 %3 %x4)
rule peeph-2217
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2, k3, k4 in u16; o1 in s8; x0 in -32768..65535
    if: 0 <= (k2 + k3) && (k2 + k3) <= 255 && k4 == (k2 + k3)  // immdInRange(0 0xFF '+' %2 %3 %x4)
    if: x0 == k2 + k3
    before:
        ld	v1, #x0
    after:
        ld	v1, #k4
    dead: below SP

// peeph.def:2224: common peephole 130c added +%3 to immediate %2
// if operandsLiteral(%2 %3), immdInRange(0 0xFFFF '+' %2 %3 %x4), canSplitReg(%1 %0 %0)
rule peeph-2224
    for: v1 in bc | de | hl
    for: k2, k3, k4 in u16; x0 in -32768..65535
    if: 0 <= (k2 + k3) && (k2 + k3) <= 65535 && k4 == (k2 + k3)  // immdInRange(0 0xFFFF '+' %2 %3 %x4)
    if: x0 == k2 + k3
    before:
        ld	v1, #x0
    after:
        ld	v1, #k4
    dead: below SP

// peeph.def:2231: common peephole 130d removed unnecessary -0 from constant
rule peeph-2231
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2 in u16; o1 in s8
    before:
        ld	v1, #k2 - 0
    after:
        ld	v1, #k2
    dead: below SP

// peeph.def:2238: common peephole 130e subtracted -%3 from immediate %2
// if operandsLiteral(%2 %3), immdInRange(0 0xFF '-' %2 %3 %x4)
rule peeph-2238
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2, k3, k4 in u16; o1 in s8; x0 in -32768..65535
    if: 0 <= (k2 - k3) && (k2 - k3) <= 255 && k4 == (k2 - k3)  // immdInRange(0 0xFF '-' %2 %3 %x4)
    if: x0 == k2 - k3
    before:
        ld	v1, #x0
    after:
        ld	v1, #k4
    dead: below SP

// peeph.def:2245: common peephole 130f subtracted -%3 from to immediate %2
// if operandsLiteral(%2 %3), immdInRange(0 0xFFFF '-' %2 %3 %x4), canSplitReg(%1 %0 %0)
rule peeph-2245
    for: v1 in bc | de | hl
    for: k2, k3, k4 in u16; x0 in -32768..65535
    if: 0 <= (k2 - k3) && (k2 - k3) <= 65535 && k4 == (k2 - k3)  // immdInRange(0 0xFFFF '-' %2 %3 %x4)
    if: x0 == k2 - k3
    before:
        ld	v1, #x0
    after:
        ld	v1, #k4
    dead: below SP

// peeph.def:2261: common peephole 130h removed unnecessary +0 to immediate
rule peeph-2261
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1, k2 in u16; o1 in s8
    before:
        ld	(k2 + 0), v1
    after:
        ld	(k2), v1
    dead: below SP

// peeph.def:2268: common peephole 131a incremented in hl instead of iy.
rule peeph-2268
    before:
        push	hl
        pop	iy
        pop	hl
        inc	iy
    after:
        inc	hl
        push	hl
        pop	iy
        pop	hl
    dead: below SP

// peeph.def:2281: common peephole 131b incremented in bc instead of iy.
// if notUsed('bc')
rule peeph-2281
    before:
        push	bc
        pop	iy
        inc	iy
    after:
        inc	bc
        push	bc
        pop	iy
    dead: BC, below SP

// peeph.def:2292: common peephole 132 added in iy instead of hl.
// if notUsed('hl'), notSame(%2 'hl')
rule peeph-2292
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k1, k2 in u16; o1, o2 in s8
    if: v2 != hl  // notSame(%2 'hl')
    if: hl != v1  // not ld x, x
    before:
        ld	hl, v1
        add	hl, v2
        push	hl
        pop	iy
    after:
        ld	iy, v1
        add	iy, v2
    dead: HL, below SP

// peeph.def:2303: common peephole 133 removed redundant pop af.
// if notUsed('a')
rule peeph-2303
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: sp != v1  // not ld x, x
    before:
        pop	af
        ld	sp, v1
    after:
        ld	sp, v1
    dead: A, below SP

// peeph.def:2311: common peephole 134 removed redundant inc sp.
rule peeph-2311
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    if: sp != v1  // not ld x, x
    before:
        inc	sp
        ld	sp, v1
    after:
        ld	sp, v1
    dead: below SP

// peeph.def:2319: common peephole 135 replaced call at end of function by jump (tail call optimization).
// if symmParmStack(%1)
rule peeph-2319
    before:
        call	l1
        ret
    after:
        jp	l1
    dead: below SP

// peeph.def:2328: common peephole 136 replaced call at end of function by jump moving call beyond pop ix (tail call optimization).
// if symmParmStack(%1)
rule peeph-2328
    before:
        call	l1
        pop	ix
        ret
    after:
        pop	ix
        jp	l1
    dead: below SP

// peeph.def:2338: common peephole 137 removed load of #%2 into %1 since it's still there.
// if notVolatile(%1), operandsNotRelated(%3 %1), notSame(%1 '(hl+)' '(hl-)')
rule peeph-2338
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k3 | (k3) | o3 (ix) | o3 (iy)
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k1, k2, k3, k4 in u16; o1, o3, o4 in s8
    if: ((v3 == a || v3 == af) && (v1 != a && v1 != af)) || ((v3 == b || v3 == c || v3 == bc) && (v1 != b && v1 != c && v1 != bc && v1 != '(bc)')) || ((v3 == d || v3 == e || v3 == de) && (v1 != d && v1 != e && v1 != de && v1 != '(de)')) || ((v3 == h || v3 == l || v3 == hl) && (v1 != h && v1 != l && v1 != hl && v1 != '(hl)')) || (v3 == sp && v1 != sp) || (v3 == '(hl)' && (v1 != h && v1 != l && v1 != hl && v1 != '(hl)' && v1 != '(k1)')) || (v3 == '(de)' && (v1 != d && v1 != e && v1 != de && v1 != '(de)' && v1 != '(k1)')) || (v3 == '(bc)' && (v1 != b && v1 != c && v1 != bc && v1 != '(bc)' && v1 != '(k1)')) || (v3 == ix && (v1 != ix && v1 != 'o1 (ix)')) || (v3 == iy && (v1 != iy && v1 != 'o1 (iy)')) || (v3 == '#k3' && (v1 != '#k1' || (v1 == '#k1' && !(k1 == k3)))) || (v3 == '(k3)' && v1 != '(k1)') || (v3 == 'o3 (ix)' && (v1 != ix && v1 != '(k1)' && v1 != 'o1 (ix)')) || (v3 == 'o3 (iy)' && (v1 != iy && v1 != '(k1)' && v1 != 'o1 (iy)'))  // operandsNotRelated(%3 %1)
    if: v1 != '(hl+)' && v1 != '(hl-)'  // notSame(%1 '(hl+)' '(hl-)')
    if: v3 != v4  // not ld x, x
    before:
        ld	v1, #k2
        ld	v3, v4
        ld	v1, #k2
    after:
        ld	v1, #k2
        ld	v3, v4
    dead: below SP

// peeph.def:2348: common peephole 138 used #%1 from hl for load into de.
rule peeph-2348
    for: k1 in u16
    before:
        ld	hl, #k1
        ld	de, #k1
    after:
        ld	hl, #k1
        ld	e, l
        ld	d, h
    dead: below SP

// peeph.def:2358: common peephole 139 replaced addition by increment.
rule peeph-2358
    before:
        ld	sp, hl
        ld	hl, #0x0002
        add	hl, sp
    after:
        ld	sp, hl
        inc	hl
        inc	hl
    dead: below SP

// peeph.def:2369: common peephole 140 removed ex exploiting commutativity of addition.
// if notUsed('de')
rule peeph-2369
    for: k1 in u16
    before:
        ex	de, hl
        ld	hl, #k1
        add	hl, de
    after:
        ld	de, #k1
        add	hl, de
    dead: DE, below SP

// peeph.def:2379: common peephole 140a removed ex exploiting commutativity of addition.
// if notUsed('de')
rule peeph-2379
    before:
        ex	de, hl
        pop	de
        add	hl, de
    after:
        pop	hl
        add	hl, de
    dead: DE, below SP

// peeph.def:2389: common peephole 140b removed ex exploiting commutativity of addition.
// if notUsed('de')
rule peeph-2389
    before:
        ex	de, hl
        pop	hl
        add	hl, de
    after:
        pop	de
        add	hl, de
    dead: DE, below SP

// peeph.def:2399: common peephole 140c removed ex before push
// if notUsed('de' 'hl')
rule peeph-2399
    before:
        ex	de, hl
        push	hl
    after:
        push	de
    dead: DE, HL, below SP

// peeph.def:2407: common peephole 140d removed ex before push
// if notUsed('de' 'hl')
rule peeph-2407
    before:
        ex	de, hl
        push	de
    after:
        push	hl
    dead: DE, HL, below SP

// peeph.def:2415: common peephole 141 moved increment to constant.
// if notUsed('hl')
rule peeph-2415
    for: v2 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k2 | (k2) | o2 (ix) | o2 (iy)
    for: k1, k2 in u16; o2 in s8
    before:
        ld	hl, #k1
        add	hl, v2
        ex	de, hl
        inc	de
    after:
        ld	hl, #k1+1
        add	hl, v2
        ex	de, hl
    dead: HL, below SP

// peeph.def:2428: common peephole 142 used ex to move hl onto the stack.
// if isPort('z80' 'z80n' 'z180' 'ez80'), notUsed('sf' 'zf' 'hf' 'pf' 'nf' 'cf'), notUsed('a'), notUsed('hl')
rule peeph-2428
    before:
        pop	af
        push	hl
    after:
        ex	(sp), hl
    dead: A, CF, HF, HL, NF, PVF, SF, ZF, below SP

// peeph.def:2436: common peephole 143 used ex to move hl onto the stack.
// if isPort('z80' 'z80n' 'z180' 'ez80'), notUsed('sf' 'zf' 'hf' 'pf' 'nf' 'cf'), notUsed('a'), notUsed('hl')
rule peeph-2436
    for: k1 in u16
    before:
        pop	af
        ld	hl, #k1
        push	hl
    after:
        ld	hl, #k1
        ex	(sp), hl
    dead: A, CF, HF, HL, NF, PVF, SF, ZF, below SP

// peeph.def:2446: common peephole 144 used ex to move #%1 onto the stack.
// if isPort('z80' 'z80n' 'z180' 'ez80'), notUsed('sf' 'zf' 'hf' 'pf' 'nf' 'cf'), notUsed('a'), notUsed('hl')
rule peeph-2446
    for: k1 in u16
    before:
        pop	af
        inc	sp
        ld	hl, #k1
        push	hl
    after:
        inc	sp
        ld	hl, #k1
        ex	(sp), hl
    dead: A, CF, HF, HL, NF, PVF, SF, ZF, below SP

// peeph.def:2458: common peephole 145 used ex to move %1 (ix) %2 (ix) onto the stack.
// if isPort('z80' 'z80n' 'z180' 'ez80'), notUsed('sf' 'zf' 'hf' 'pf' 'nf' 'cf'), notUsed('a'), notUsed('hl')
rule peeph-2458
    for: k1, k2 in s8
    before:
        pop	af
        inc	sp
        ld	h, k1 (ix)
        ld	l, k2 (ix)
        push	hl
    after:
        inc	sp
        ld	h, k1 (ix)
        ld	l, k2 (ix)
        ex	(sp), hl
    dead: A, CF, HF, HL, NF, PVF, SF, ZF, below SP

// peeph.def:2472: common peephole 146 used ex to move #%1 onto the stack.
// if isPort('z80' 'z80n' 'z180' 'ez80'), notUsed('sf' 'zf' 'hf' 'pf' 'nf' 'cf'), notUsed('a'), notUsed('hl')
rule peeph-2472
    for: k1 in u16
    before:
        pop	af
        ld	a, #k1
        push	af
        inc	sp
    after:
        ld	h, #k1
        ex	(sp), hl
        inc	sp
    dead: A, CF, HF, HL, NF, PVF, SF, ZF, below SP

// peeph.def:2484: common peephole 147 directly used #%2 instead of going through %1 using indirect addressing.
rule peeph-2484
    for: v1 in ix | iy
    for: v5 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k5 | (k5) | o5 (ix) | o5 (iy)
    for: k2, k5 in u16; k3 in -128..65535; o5 in s8; x0 in -32768..65535
    if: x0 == k2 + k3
    if: v1 != v5  // not ld x, x
    before:
        ld	v1, #k2
        ld	k3 (v1), a
        l4:
        ld	v1, v5
    after:
        ld	(x0), a
        l4:
        ld	v1, v5
    dead: below SP

// peeph.def:2496: common peephole 148 used #%2 directly instead of going through %1 using indirect addressing.
// if notSame(%3 'a')
rule peeph-2496
    for: v1 in ix | iy
    for: v4 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k4 | (k4) | o4 (ix) | o4 (iy)
    for: k2, k4, k5 in u16; k3 in -128..65535; o4 in s8; x0 in -32768..65535
    if: k3 != a  // notSame(%3 'a')
    if: x0 == k2 + k3
    before:
        pop	af
        ld	v1, #k2
        ld	k3 (v1), v4
        ld	v1, #k5
    after:
        ld	a, v4
        ld	(x0), a
        pop	af
        ld	v1, #k5
    dead: below SP

// peeph.def:2509: common peephole 149 tested bit %2 of a directly instead of going through %1.
// if notUsed(%1)
rule peeph-2509
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v2 in 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7
    for: k1 in u16; o1 in s8
    if: v1 != a  // not ld x, x
    before:
        ld	v1, a
        bit	v2, v1
    after:
        bit	v2, a
    dead: v1

// peeph.def:2517: common peephole 150 used sign flag instead of testing bit 7.
// if isPort('z80' 'ez80' 'z180' 'z80n' 'tlcs90')
rule peeph-2517
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        sbc	a, v1
        bit	7, a
        jp	nz, l2
    after:
        sbc	a, v1
        jp	m, l2
    dead: below SP

// peeph.def:2527: common peephole 151 used value still in a instead of reloading from %1.
rule peeph-2527
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v3 in z | nz | c | nc | po | pe | p | m
    for: k1 in u16; o1 in s8
    if: v1 != a  // not ld x, x
    if: a != v1  // not ld x, x
    before:
        ld	v1, a
        or	a, a
        jp	v3, l4
        ld	a, v1
    after:
        ld	v1, a
        or	a, a
        jp	v3, l4
    dead: below SP

// peeph.def:2539: common peephole 152 removed unused ret.
rule peeph-2539
    before:
        jp	l5
        ret
    after:
        jp	l5
    dead: below SP

// peeph.def:2547: common peephole 153 removed unused ret.
rule peeph-2547
    before:
        jp	l5
        ld	sp, ix
        pop	ix
        ret
    after:
        jp	l5
    dead: below SP

// peeph.def:2557: common peephole 154a removed redundant zeroing of a (which has just been tested to be #0x00).
// if same(%4 'or' 'and'), notUsed('f')
rule peeph-2557
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v4 in or | and
    for: k1 in u16; o1 in s8
    if: v4 == 'or' || v4 == 'and'  // same(%4 'or' 'and')
    before:
        v4	a, v1
        jp	nz, l2
        xor	a, a
    after:
        v4	a, v1
        jp	nz, l2
    dead: CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:2567: common peephole 154b removed redundant zeroing of a (which has just been tested to be #0x00).
// if same(%4 'inc' 'dec'), notUsed('f')
rule peeph-2567
    for: v4 in inc | dec
    if: v4 == 'inc' || v4 == 'dec'  // same(%4 'inc' 'dec')
    before:
        v4	a
        jp	nz, l2
        xor	a, a
    after:
        v4	a
        jp	nz, l2
    dead: CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:2577: common peephole 154c reuseded zero of register (which has just been tested to be #0x00).
// if same(%4 'inc' 'dec'), notUsed('f')
rule peeph-2577
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: v4 in inc | dec
    for: k1 in u16; o1 in s8
    if: v4 == 'inc' || v4 == 'dec'  // same(%4 'inc' 'dec')
    before:
        v4	v1
        jp	nz, l2
        xor	a, a
    after:
        v4	v1
        jp	nz, l2
        ld	a, v1
    dead: CF, HF, NF, PVF, SF, ZF, below SP

// peeph.def:2588: common peephole 155a turned add into inc.
// if operandsLiteral(%1), immdInRange(1 1 '+' %1 0 %2), notUsed('cf')
rule peeph-2588
    for: k1 in u16
    if: 1 <= (k1 + 0) && (k1 + 0) <= 1  // immdInRange(1 1 '+' %1 0 %2)
    before:
        add	a, #k1
    after:
        inc	a
    dead: CF, below SP

// peeph.def:2595: common peephole 155b turned sub into dec.
// if operandsLiteral(%1), immdInRange(1 1 '+' %1 0 %2), notUsed('cf')
rule peeph-2595
    for: k1 in u16
    if: 1 <= (k1 + 0) && (k1 + 0) <= 1  // immdInRange(1 1 '+' %1 0 %2)
    before:
        sub	a, #k1
    after:
        dec	a
    dead: CF, below SP

// peeph.def:2602: common peephole 155c turned add into dec.
// if operandsLiteral(%1), immdInRange(0xFF 0xFF '+' %1 0 %2), notUsed('cf')
rule peeph-2602
    for: k1 in u16
    if: 255 <= (k1 + 0) && (k1 + 0) <= 255  // immdInRange(0xFF 0xFF '+' %1 0 %2)
    before:
        add	a, #k1
    after:
        dec	a
    dead: CF, below SP

// peeph.def:2609: common peephole 156a swap dec %1 / inc %1 pair.
rule peeph-2609
    for: v1 in a | b | c | d | e | h | l | bc | de | hl | sp | af | (hl) | (de) | (bc) | ix | iy | #k1 | (k1) | o1 (ix) | o1 (iy)
    for: k1 in u16; o1 in s8
    before:
        dec	v1
        inc	v1
    after:
        inc	v1
        dec	v1
    dead: below SP

// peeph.def:2618: common peephole 156b removed inc %1 / dec %1 pair.
// if same(%1 'bc' 'de' 'hl' 'ix' 'iy' 'sp')
rule peeph-2618
    for: v1 in bc | de | hl | ix | iy | sp
    if: v1 == bc || v1 == de || v1 == hl || v1 == ix || v1 == iy || v1 == sp  // same(%1 'bc' 'de' 'hl' 'ix' 'iy' 'sp')
    before:
        inc	v1
        dec	v1
    after:
    dead: below SP

// peeph.def:2625: common peephole 156c removed inc %1 / dec %1 pair.
// if same(%1 'a' 'b' 'c' 'd' 'e' 'h' 'l' 'ixh' 'ixl' 'iyh' 'iyl'), notUsed('zf' 'vf' 'sf' 'nf' 'hf')
rule peeph-2625
    for: v1 in a | b | c | d | e | h | l
    if: v1 == a || v1 == b || v1 == c || v1 == d || v1 == e || v1 == h || v1 == l || v1 == ixh || v1 == ixl || v1 == iyh || v1 == iyl  // same(%1 'a' 'b' 'c' 'd' 'e' 'h' 'l' 'ixh' 'ixl' 'iyh' 'iyl')
    before:
        inc	v1
        dec	v1
    after:
    dead: HF, NF, PVF, SF, ZF, below SP

// peeph.def:2632: common peephole 156e removed inc %1 / dec %1 pair.
// if same(%1 'bc' 'de' 'hl' 'ix' 'iy' 'sp'), same(%2 'bc' 'de' 'hl' 'ix' 'iy' 'sp'), operandsNotRelated(%1 %2)
rule peeph-2632
    for: v1 in bc | de | hl | ix | iy | sp
    for: v2 in bc | de | hl | ix | iy | sp
    if: v1 == bc || v1 == de || v1 == hl || v1 == ix || v1 == iy || v1 == sp  // same(%1 'bc' 'de' 'hl' 'ix' 'iy' 'sp')
    if: v2 == bc || v2 == de || v2 == hl || v2 == ix || v2 == iy || v2 == sp  // same(%2 'bc' 'de' 'hl' 'ix' 'iy' 'sp')
    if: (v1 == bc && v2 != bc) || (v1 == de && v2 != de) || (v1 == hl && v2 != hl) || (v1 == ix && v2 != ix) || (v1 == iy && v2 != iy) || (v1 == sp && v2 != sp)  // operandsNotRelated(%1 %2)
    before:
        inc	v2
        inc	v1
        dec	v1
    after:
        inc	v1
        inc	v2
        dec	v1
    dead: below SP

// peeph.def:2643: common peephole 168z used double assignment in case of z condition.
// if labelRefCountChange(%2 -1)
rule peeph-2643
    for: k3, k4 in u16
    before:
        jp	z, l2
        ld	a, #k3
        jp	l1
        l2:
        ld	a, #k4
        l1:
    after:
        ld	a, #k3
        jp	nz, l1
        l2:
        ld	a, #k4
        l1:
    dead: below SP

// peeph.def:2659: common peephole 168nz used double assignment in case of nz condition.
// if labelRefCountChange(%2 -1)
rule peeph-2659
    for: k3, k4 in u16
    before:
        jp	nz, l2
        ld	a, #k3
        jp	l1
        l2:
        ld	a, #k4
        l1:
    after:
        ld	a, #k3
        jp	z, l1
        l2:
        ld	a, #k4
        l1:
    dead: below SP

// peeph.def:2675: common peephole 169xz used double assignment in case of z condition.
// if labelRefCountChange(%2 -1)
rule peeph-2675
    for: k3 in u16
    before:
        jp	z, l2
        ld	a, #k3
        jp	l1
        l2:
        xor	a, a
        l1:
    after:
        ld	a, #k3
        jp	nz, l1
        l2:
        xor	a, a
        l1:
    dead: below SP

// peeph.def:2691: common peephole 169xnz used double assignment in case of nz condition.

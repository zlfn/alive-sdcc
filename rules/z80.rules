    if: ((v3 == a || v3 == sp || v3 == af || v3 == ix || v3 == iy || v3 == '#k3' || v3 == '(k3)' || v3 == 'o3 (ix)' || v3 == 'o3 (iy)') && ((v5 == bc && v6 != bc) || (v5 == de && v6 != de) || (v5 == hl && v6 != hl))) || ((v3 == b || v3 == c || v3 == bc || v3 == '(bc)') && ((v5 == de && v6 == hl) || (v5 == hl && v6 == de))) || ((v3 == d || v3 == e || v3 == de || v3 == '(de)') && ((v5 == bc && v6 == hl) || (v5 == hl && v6 == bc))) || ((v3 == h || v3 == l || v3 == hl || v3 == '(hl)') && ((v5 == bc && v6 == de) || (v5 == de && v6 == bc)))  // operandsNotRelated(%3 %5 %6)
